plot_phylum_bars <- function(ps_obj, kingdom_title) {

  ps_phylum <- tax_glom(ps_obj, taxrank = "Phylum", NArm = FALSE)
  ps_rel    <- transform_sample_counts(ps_phylum, function(x) x / sum(x))
  df        <- psmelt(ps_rel)
  meta_df   <- as(sample_data(ps_obj), "data.frame")

  type_n <- meta_df %>%
    group_by(SampleType) %>% summarise(n = n(), .groups = "drop") %>%
    mutate(Type_Label = paste0(SampleType, "\n(n = ", n, ")"))
  loc_n <- meta_df %>%
    group_by(Location) %>% summarise(n = n(), .groups = "drop") %>%
    mutate(Loc_Label = paste0(Location, "\n(n = ", n, ")"))

  df$Phylum <- ifelse(is.na(df$Phylum), "Unclassified", as.character(df$Phylum))
  abundant_phyla <- df %>%
    group_by(Phylum) %>% summarise(m = mean(Abundance), .groups = "drop") %>%
    filter(m >= 0.01) %>% pull(Phylum)

  df <- df %>%
    mutate(Phylum = ifelse(Phylum %in% abundant_phyla, as.character(Phylum), "Others < 1%")) %>%
    group_by(Sample, SampleType, Location, Phylum) %>%
    summarise(Abundance = sum(Abundance), .groups = "drop") %>%
    left_join(type_n, by = "SampleType") %>%
    left_join(loc_n,  by = "Location")
  stopifnot(all(abs(tapply(df$Abundance, df$Sample, sum) - 1) < 1e-8))

  all_phyla <- c(sort(setdiff(unique(df$Phylum), "Others < 1%")), "Others < 1%")
  df$Phylum <- factor(df$Phylum, levels = all_phyla)
  pal <- pal_phylum(all_phyla)

  base_theme <- theme_pub() +
    theme(legend.position = "right",
          plot.title      = element_text(size = 14, face = "bold", hjust = 0.5))

  p_type <- df %>%
    filter(!is.na(SampleType)) %>%
    group_by(Type_Label, Phylum) %>%
    summarise(Abundance = mean(Abundance), .groups = "drop") %>%
    ggplot(aes(x = Type_Label, y = Abundance, fill = Phylum)) +
    geom_bar(stat = "identity", position = "stack", color = "black", linewidth = 0.2) +
    scale_fill_manual(values = pal) +
    scale_y_continuous(labels = percent_format(accuracy = 1),
                       expand = expansion(mult = c(0, 0.05))) +
    base_theme +
    theme(axis.text.x = element_text(angle = 0, hjust = 0.5, size = 11, face = "bold")) +
    labs(title = paste(kingdom_title, "- By Sample Type"),
         y = "Relative abundance", x = "Substrate")

  p_loc <- df %>%
    filter(!is.na(Location)) %>%
    group_by(Loc_Label, Phylum) %>%
    summarise(Abundance = mean(Abundance), .groups = "drop") %>%
    ggplot(aes(x = Loc_Label, y = Abundance, fill = Phylum)) +
    geom_bar(stat = "identity", position = "stack", color = "black", linewidth = 0.2) +
    scale_fill_manual(values = pal) +
    scale_y_continuous(labels = percent_format(accuracy = 1),
                       expand = expansion(mult = c(0, 0.05))) +
    base_theme +
    theme(axis.text.x = element_text(angle = 45, hjust = 1, size = 10, face = "bold")) +
    labs(title = paste(kingdom_title, "- By Location"),
         y = "Relative abundance", x = "Site")

  comp_tab <- bind_rows(
    df %>% group_by(Group = as.character(SampleType), Phylum) %>%
      summarise(Mean_Rel_Abundance = mean(Abundance), .groups = "drop") %>% mutate(Grouping = "SampleType"),
    df %>% group_by(Group = as.character(Location), Phylum) %>%
      summarise(Mean_Rel_Abundance = mean(Abundance), .groups = "drop") %>% mutate(Grouping = "Location")) %>%
    mutate(Kingdom = kingdom_title) %>%
    select(Kingdom, Grouping, Group, Phylum, Mean_Rel_Abundance)

  list(by_type = p_type, by_location = p_loc, table = comp_tab)
}

