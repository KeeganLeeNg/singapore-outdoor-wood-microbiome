  con <- if(!is.null(q)) q[ q$bin %in% CONTAMINANT_BINS, , drop = FALSE] else NULL
  ncp <- function(d) sum(as.numeric(d$completeness) >= 90 & as.numeric(d$contamination) <= 5, na.rm = TRUE)
  put("N_HQMQ",     nrow(q));   put("N_RETAINED", nrow(ret))
  put("N_BINS_TOTAL", nrow(read.delim(QUAL, stringsAsFactors = FALSE)))
  put("N_LQ",       nrow(read.delim(QUAL, stringsAsFactors = FALSE)) - nrow(q))
  put("N_NC_ALL",   ncp(q));    put("N_NC_RET", ncp(ret))
  put("N_23S",      sum(as.logical(q$has_23S), na.rm = TRUE))
  put("N_SPECIES_UNASSIGNED_ALL", sum(is.na(q$species) | trimws(q$species) == ""))
  put("N_MIMAG_HQ", sum(grepl("^MIMAG high quality", rd("M4_mimag_verification.csv")$mimag_class)))
  put("CONTAM_COMP",  if(nrow(con) == 1) f2(as.numeric(con$completeness))  else NA)
  put("CONTAM_COMP1", if(nrow(con) == 1) f1(as.numeric(con$completeness))  else NA)
  put("CONTAM_CONT",  if(nrow(con) == 1) f2(as.numeric(con$contamination)) else NA)

  rec <- tryCatch(rd("M4_mag_read_recruitment.csv"), error = function(e) NULL)
  cab <- tryCatch({
    ra <- read.delim(file.path(SHOT, "MAG_relative_abundance.tsv"), check.names = FALSE, stringsAsFactors = FALSE)
    names(ra) <- sub("^(M[0-9]+)[^0-9].*$", "\\1", names(ra))
