#!/usr/bin/env python3
import csv, hashlib, os, re, sys
from collections import Counter, OrderedDict

BACT_IN  = "Merged_B1_to_B7_Sequence_Absolute_V4trim.txt"
FUNGI_IN = "Merged_B1_to_B7_Fungi_Sequence_Absolute.txt"
BACT_OUT  = "Merged_B1_to_B7_Sequence_Absolute_V4trim_SILVA138.2.txt"
FUNGI_OUT = "Merged_B1_to_B7_Fungi_Sequence_Absolute_UNITE10.txt"
EXPECT = {BACT_IN:  ("d626f46dbd5121bf532d04e383962626", 54431, 107),
          FUNGI_IN: ("c5b4609299e3dd097119fe9d034e441b", 16183, 156)}
PICRUST_FASTA_MD5 = "fb78e55d4962605f1926dcce80a893bd"   # picrust2/study_seqs_V4trim.fasta
RANK_PREFIX = "kpcofgs"


def md5(path):
    h = hashlib.md5()
    with open(path, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def read_table(path):
    """Merged table: Sequence, Taxonomy, then one column of absolute read counts per sample."""
    name = os.path.basename(path)
    want_md5, want_rows, want_samples = EXPECT[name]
    got = md5(path)
    if got != want_md5:
        sys.exit(f"STOP: {name} is not the expected file (md5 {got}, expected {want_md5}).")
    with open(path, newline="") as fh:
        r = csv.reader(fh, delimiter="\t")
        hdr = next(r)
        rows = [row for row in r if row]
    assert hdr[:2] == ["Sequence", "Taxonomy"], hdr[:2]
    assert len(rows) == want_rows and len(hdr) - 2 == want_samples, (name, len(rows), len(hdr))
    assert all(len(row) == len(hdr) for row in rows), name
    seqs = [row[0] for row in rows]
    assert len(set(seqs)) == len(seqs), f"{name}: duplicated sequences"
    assert all(re.fullmatch(r"[ACGT]+", s) for s in seqs), f"{name}: sequence with a character other than ACGT"
    return hdr, rows


def ids_for(kind, n):
    return [f"ASV_{i}" if kind == "bact" else f"fseq_{i}" for i in range(1, n + 1)]


def write_fasta(path, ids, seqs):
    with open(path, "w") as f:
        for i, s in zip(ids, seqs):
            f.write(f">{i}\n{s}\n")


def read_fasta(path):
    out, name, buf = OrderedDict(), None, []
    for line in open(path):
        line = line.rstrip("\n")
        if line.startswith(">"):
            if name is not None:
                out[name] = "".join(buf)
            name, buf = line[1:].split()[0], []
        elif line:
            buf.append(line)
    if name is not None:
        out[name] = "".join(buf)
    return out


def provider_format(taxon):
    """QIIME 2 label -> the layout of the provider's tables, which the R pipeline parses (split on ';', strip ^[kpcofgs]__).
    SILVA writes the top rank as d__ (domain); the R pipeline expects k__. Ranks must be k,p,c,o,f,g,s in order,
    optionally followed by UNITE's species-hypothesis code (sh__...) after a full seven-rank label."""
    taxon = taxon.strip()
    if taxon == "Unassigned":
        return taxon
    parts = [p.strip() for p in taxon.split(";")]
    if parts[0].startswith("d__"):
        parts[0] = "k__" + parts[0][3:]
    ranks7, extra = parts[:7], parts[7:]
    ok = all(p.startswith(RANK_PREFIX[i] + "__") for i, p in enumerate(ranks7))
    ok = ok and (not extra or (len(extra) == 1 and len(parts) == 8 and extra[0].startswith("sh__")))
    if not ok:
        raise ValueError(f"unexpected taxonomy layout: {taxon!r}")
    return ";".join(parts)


def ranks(label):
    """Same parsing as the R pipeline: separate(sep=';', fill='right') then remove ^[kpcofgs]__."""
    parts = label.split(";")[:7]
    parts += [None] * (7 - len(parts))
    return [None if p is None else re.sub(r"^[kpcofgs]__", "", p) for p in parts]


def prevalence(row):
    return sum(1 for x in row[2:] if float(x) > 0)


def reads(row):
    return sum(float(x) for x in row[2:])


def keep_bact(label, row):
    k, p, c, o, f, g, s = ranks(label)
    return k == "Bacteria" and o != "Chloroplast" and f != "Mitochondria" and prevalence(row) > 1


def keep_fungi(label, row):
    return ranks(label)[0] == "Fungi" and prevalence(row) > 1


def prepare(root):
    inp, wk = os.path.join(root, "reclassify", "input"), os.path.join(root, "reclassify", "work")
    os.makedirs(wk, exist_ok=True)
    for kind, fn in (("bact", BACT_IN), ("fungi", FUNGI_IN)):
        hdr, rows = read_table(os.path.join(inp, fn))
        out = os.path.join(wk, f"{kind}_ASVs.fasta")
        write_fasta(out, ids_for(kind, len(rows)), [r[0] for r in rows])
        print(f"[prepare] {kind}: {len(rows)} ASVs x {len(hdr) - 2} samples -> {out} (md5 {md5(out)})")
    if md5(os.path.join(wk, "bact_ASVs.fasta")) != PICRUST_FASTA_MD5:
        sys.exit("STOP: bact_ASVs.fasta differs from the PICRUSt2 input; the ASV_ IDs would not match.")
    print("[prepare] bact_ASVs.fasta is identical to picrust2/study_seqs_V4trim.fasta (same ASV_ IDs)")


def read_taxonomy(path, want_ids):
    with open(path, newline="") as fh:
        r = csv.reader(fh, delimiter="\t")
        hdr = next(r)
        assert hdr[:2] == ["Feature ID", "Taxon"], hdr
        ci = hdr.index("Confidence") if "Confidence" in hdr else None
        tax = {}
        for row in r:
            if not row or row[0].startswith("#"):
                continue
            assert row[0] not in tax, f"duplicated ID in {path}: {row[0]}"
            tax[row[0]] = (row[1], row[ci] if ci is not None else "")
    missing, extra = set(want_ids) - set(tax), set(tax) - set(want_ids)
    assert not missing and not extra, f"{path}: {len(missing)} IDs missing, {len(extra)} unexpected"
    return tax


def pct(a, b):
    return f"{100.0 * a / b:.2f}%" if b else "n/a"


def relabel(root):
    rc = os.path.join(root, "reclassify")
    inp, wk, out = (os.path.join(rc, d) for d in ("input", "work", "output"))
    os.makedirs(out, exist_ok=True)
    rep = []
    say = lambda s="": (print(s), rep.append(s))
    marker = OrderedDict()

    say("# Classification of the amplicon ASVs (QIIME 2 2026.7, classify-sklearn, confidence 0.7)")
    say("# Bacteria: SILVA 138.2 SSURef NR99, trained on the 515F/806R region "
        "(GTGCCAGCMGCCGCGGTAA / GGACTACHVGGGTWTCTAAT)")
    say("# Fungi:    UNITE 10.0 (2025-02-19), all eukaryotes, 99% clusters, no singletons, full-length ITS")
    say("# 'provider' = the label delivered with the merged table; 'assigned' = this classification.")

    jobs = (("bact", BACT_IN, BACT_OUT, "SILVA138.2", keep_bact, "bact_tree", "bact_V4trim_for_tree.fasta", "seq_"),
            ("fungi", FUNGI_IN, FUNGI_OUT, "UNITE10", keep_fungi, "fungi_tree", "fungi_for_tree.fasta", "fseq_"))
    for kind, fin, fout, db, keep, tdir, tfile, tip in jobs:
        hdr, rows = read_table(os.path.join(inp, fin))
        ids = ids_for(kind, len(rows))
        fasta = read_fasta(os.path.join(wk, f"{kind}_ASVs.fasta"))
        assert list(fasta) == ids and all(fasta[i] == r[0] for i, r in zip(ids, rows)), \
            f"{kind}_ASVs.fasta does not match the table row by row"
        tax = read_taxonomy(os.path.join(wk, f"{kind}_taxonomy_export", "taxonomy.tsv"), ids)
        new = [provider_format(tax[i][0]) for i in ids]
        conf = [tax[i][1] for i in ids]
        prov = [r[1] for r in rows]

        # 1. relabelled merged table: identical to the input except for the Taxonomy column
        path = os.path.join(out, fout)
        with open(path, "w", newline="") as f:
            w = csv.writer(f, delimiter="\t", lineterminator="\n")
            w.writerow(hdr)
            for r, lab in zip(rows, new):
                w.writerow([r[0], lab] + r[2:])
        with open(path, newline="") as fh:
            chk = list(csv.reader(fh, delimiter="\t"))
        assert chk[0] == hdr and len(chk) - 1 == len(rows)
        assert all(c[0] == r[0] and c[2:] == r[2:] and c[1] == lab for c, r, lab in zip(chk[1:], rows, new)), \
            f"{fout}: sequence or count changed"

        # 2. tree input with the pipeline filters (assigned labels); the count under the provider's labels beside it
        sel = [(i, r[0]) for i, r, lab in zip(ids, rows, new) if keep(lab, r)]
        n_prov = sum(1 for r in rows if keep(r[1], r))
        os.makedirs(os.path.join(root, tdir), exist_ok=True)
        tpath = os.path.join(root, tdir, tfile)
        if kind == "bact":
            tips = [(f"seq_{k}", s) for k, (_, s) in enumerate(sel, 1)]     # seq_1..seq_n; R joins by sequence
        else:
            tips = [(i, s) for i, s in sel]                                 # fseq_<row> = R Short_ID
        write_fasta(tpath, [t for t, _ in tips], [s for _, s in tips])
        in_tree = {i for i, _ in sel}

        # 3. table of the provider's label beside the assigned label
        cpath = os.path.join(out, f"{kind}_taxonomy_provider_vs_assigned.tsv")
        with open(cpath, "w", newline="") as f:
            w = csv.writer(f, delimiter="\t", lineterminator="\n")
            w.writerow(["ID", "Total_reads", "Samples_present", "Provider_label", f"Assigned_label_{db}",
                        "Confidence", "In_tree_input", "Sequence"])
            for i, r, o, nlab, c in zip(ids, rows, prov, new, conf):
                w.writerow([i, f"{reads(r):.0f}", prevalence(r), o, nlab, c, "yes" if i in in_tree else "no", r[0]])

        # 4. report
        tot = sum(reads(r) for r in rows)
        say()
        say(f"== {'BACTERIA' if kind == 'bact' else 'FUNGI'}: {len(rows)} ASVs, {len(hdr) - 2} samples, "
            f"{tot:.0f} reads")
        top = Counter()
        topr = Counter()
        for lab, r in zip(new, rows):
            k = ranks(lab)[0]
            top[k] += 1
            topr[k] += reads(r)
        say(f"Top rank ({'domain' if kind == 'bact' else 'kingdom'}), assigned labels: ASVs (share of reads)")
        for k, n in top.most_common():
            say(f"  {k:<28} {n:>7} ({pct(topr[k], tot)})")
        focal = "Bacteria" if kind == "bact" else "Fungi"
        fr = [(lab, r) for lab, r in zip(new, rows) if ranks(lab)[0] == focal]
        ftot = sum(reads(r) for _, r in fr)
        say(f"Depth of the assigned labels within {focal} (named rank, not empty): ASVs (share of {focal} reads)")
        for j, rk in enumerate(("Phylum", "Class", "Order", "Family", "Genus"), 1):
            ok = [(lab, r) for lab, r in fr if ranks(lab)[j] not in (None, "")]
            say(f"  {rk:<8} {len(ok):>7} ({pct(sum(reads(r) for _, r in ok), ftot)})")
        if kind == "bact":
            chl = [r for lab, r in zip(new, rows) if ranks(lab)[3] == "Chloroplast"]
            mit = [r for lab, r in zip(new, rows) if ranks(lab)[4] == "Mitochondria"]
            say(f"Chloroplast (Order): {len(chl)} ASVs ({pct(sum(map(reads, chl)), tot)} of reads); "
                f"Mitochondria (Family): {len(mit)} ASVs ({pct(sum(map(reads, mit)), tot)} of reads)")
            other = [lab for lab in new if ("Chloroplast" in lab and ranks(lab)[3] != "Chloroplast")
                     or ("Mitochondria" in lab and ranks(lab)[4] != "Mitochondria")]
            say(f"Chloroplast or Mitochondria at a rank the R filter does not check: {len(other)}"
                + ("" if not other else f"  WARNING, e.g. {other[0]}"))
            rule = "Domain Bacteria, Order not Chloroplast, Family not Mitochondria, present in >1 sample"
        else:
            rule = "Kingdom Fungi, present in >1 sample"
        say(f"Tree input ({rule}): {len(sel)} ASVs with the assigned labels; {n_prov} with the provider's labels")
        named = lambda x: x not in (None, "")
        say("Provider's label vs assigned label, all ASVs:")
        for j, rk in ((1, "Phylum"), (5, "Genus")):
            trip = [(ranks(o)[j], ranks(nl)[j], reads(r)) for o, nl, r in zip(prov, new, rows)]
            both = [t for t in trip if named(t[0]) and named(t[1])]
            same = [t for t in both if t[0] == t[1]]
            say(f"  {rk:<6} named in both: {len(both)} ASVs, identical name: {len(same)} "
                f"({pct(sum(t[2] for t in same), sum(t[2] for t in both))} of their reads); "
                f"named only by the provider: {sum(1 for t in trip if named(t[0]) and not named(t[1]))}; "
                f"named only here: {sum(1 for t in trip if named(t[1]) and not named(t[0]))}")
        show = lambda x: x if named(x) else "(none)"
        chg = Counter((show(ranks(o)[1]), show(ranks(nl)[1])) for o, nl in zip(prov, new)
                      if show(ranks(o)[1]) != show(ranks(nl)[1]))
        say("Most frequent phylum differences, provider -> assigned: ASVs (includes renames between database releases)")
        for (a, b), n in chg.most_common(15):
            say(f"  {a} -> {b}: {n}")
        if not chg:
            say("  none")
        for p in (path, cpath, tpath):
            say(f"md5 {md5(p)}  {os.path.relpath(p, root)}")
        marker[f"{kind}_tree_fasta"] = os.path.relpath(tpath, root)
        marker[f"{kind}_tree_n"] = str(len(sel))
        marker[f"{kind}_tree_md5"] = md5(tpath)
        marker[f"{kind}_table"] = os.path.relpath(path, root)
        marker[f"{kind}_table_md5"] = md5(path)

    with open(os.path.join(out, "reclassification_report.txt"), "w") as f:
        f.write("\n".join(rep) + "\n")
    tmp = os.path.join(out, "RECLASSIFY_DONE.txt.tmp")          # written last: the tree jobs wait for it
    with open(tmp, "w") as f:
        f.write("".join(f"{k}={v}\n" for k, v in marker.items()))
    os.replace(tmp, os.path.join(out, "RECLASSIFY_DONE.txt"))
    print("[relabel] done: reclassify/output/RECLASSIFY_DONE.txt written")


if __name__ == "__main__":
    if len(sys.argv) != 3 or sys.argv[1] not in ("prepare", "relabel"):
        sys.exit(__doc__)
    {"prepare": prepare, "relabel": relabel}[sys.argv[1]](os.path.abspath(sys.argv[2]))

