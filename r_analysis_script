cat("\n--- 25. Zi-Pi Network Topology (Keystone Taxa) ---\n")

calculate_zipi <- function(ps_sync, wood_type, top_n = 100) {

  ps_sub  <- prune_samples(
    sample_names(ps_sync)[sample_data(ps_sync)$SampleType == wood_type], ps_sync
  )
  ps_gen  <- tax_glom(ps_sub, taxrank = "Genus", NArm = TRUE)
  ps_top  <- prune_taxa(
    names(sort(taxa_sums(ps_gen), decreasing = TRUE)[1:min(top_n, ntaxa(ps_gen))]), ps_gen
  )
  mat <- as.matrix(t(otu_table(ps_top)))

  set.seed(123)
  se_res  <- spiec.easi(mat, method = "mb", nlambda = SPIEC_NLAMBDA, lambda.min.ratio = SPIEC_LAMBDA_MIN_RATIO,
                        pulsar.params = list(rep.num = 50, ncores = 1))
  se_beta <- as.matrix(symBeta(getOptBeta(se_res)))
  note_selection(se_res, "25",
                 paste(as.character(tax_table(ps_top)[1, "Kingdom"]), "genera (Zi-Pi)"),
                 wood_type, nrow(mat), ncol(mat))

  tax_info    <- as.data.frame(tax_table(ps_top))
  clean_names <- ifelse(is.na(tax_info$Genus), rownames(tax_info), tax_info$Genus)
  if (anyDuplicated(clean_names))
    stop("[25] ", wood_type, ": genus name used by more than one network node: ",
         paste(unique(clean_names[duplicated(clean_names)]), collapse = ", "), call. = FALSE)
  rownames(se_beta) <- clean_names; colnames(se_beta) <- clean_names

  adj_bin <- (abs(se_beta) > EDGE_TOL) * 1L
  diag(adj_bin) <- 0L

  g <- igraph::graph_from_adjacency_matrix(adj_bin, mode = "undirected", diag = FALSE)
  g <- igraph::delete_vertices(g, which(igraph::degree(g) == 0))

  if (igraph::vcount(g) < 4) {
    cat(paste0("[WARNING] ", wood_type, ": fewer than 4 connected nodes; Zi-Pi skipped.\n"))
    return(NULL)
  }

  set.seed(123)
  louvain      <- igraph::cluster_louvain(g)
  membership_v <- igraph::membership(louvain)

  adj_dense  <- as.matrix(igraph::as_adjacency_matrix(g, sparse = FALSE))
  node_names <- igraph::V(g)$name
  n_nodes    <- igraph::vcount(g)

  mod_assign <- membership_v[node_names]

  zi_vals <- vapply(seq_len(n_nodes), function(i) {
    s           <- mod_assign[i]
    mod_idx     <- which(mod_assign == s)
    k_vals      <- rowSums(adj_dense[mod_idx, mod_idx, drop = FALSE])
    k_is        <- sum(adj_dense[i, mod_idx])
    mu_ks       <- mean(k_vals)
    sigma_ks    <- sd(k_vals)
    if (is.na(sigma_ks) || sigma_ks == 0) return(0)
    (k_is - mu_ks) / sigma_ks
  }, numeric(1))

  k_total <- rowSums(adj_dense)
  pi_vals <- vapply(seq_len(n_nodes), function(i) {
    ki <- k_total[i]
    if (ki == 0L) return(0)
    1 - sum(vapply(unique(mod_assign), function(s) {
      mod_idx <- which(mod_assign == s)
      k_it    <- sum(adj_dense[i, mod_idx])
      (k_it / ki)^2
    }, numeric(1)))
  }, numeric(1))

  data.frame(
    Node      = node_names,
    Module    = mod_assign,
    Degree    = k_total,
    Zi        = zi_vals,
    Pi        = pi_vals,
    Condition = wood_type
  ) %>%
    mutate(Role = case_when(
      Zi >  2.5 & Pi >  0.62 ~ "Network Hub",
      Zi >  2.5 & Pi <= 0.62 ~ "Module Hub",
      Zi <= 2.5 & Pi >  0.62 ~ "Connector",
      TRUE                    ~ "Peripheral"
    ))
}

