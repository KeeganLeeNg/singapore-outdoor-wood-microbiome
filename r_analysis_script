strat_rows_plot <- function(plot_data, functions, strip_labels, fill_values, ncol, strip_size, title) {
  plot_data$Family_clean <- factor(plot_data$Family_clean, levels = names(fill_values))
  if (anyNA(plot_data$Family_clean)) stop("[strat_rows_plot] a family has no colour", call. = FALSE)
  sub_cols <- c(Natural_Log = "#2EC4B6", Processed_Wood = "#FF9F1C")
  sub_labs <- c(Natural_Log = "Natural log", Processed_Wood = "Processed wood")
  row_sets <- unname(split(functions, ceiling(seq_along(functions) / ncol)))
  rows <- lapply(row_sets, function(f_r) {
    d_main <- plot_data[plot_data$function_id %in% f_r, , drop = FALSE]
    d_main$function_id <- factor(d_main$function_id, levels = f_r)
    d_strip <- dplyr::distinct(d_main, sample, function_id, SampleType)
    d_strip$SampleType <- factor(d_strip$SampleType, levels = names(sub_cols))
    main <- ggplot(d_main, aes(x = sample, y = rel_abun, fill = Family_clean)) +
      geom_col(width = 1, show.legend = TRUE) +
      facet_wrap(~ function_id, scales = "free_x", nrow = 1, labeller = as_labeller(strip_labels)) +
      scale_fill_manual(values = fill_values, drop = FALSE, name = "Family") +
      scale_y_continuous(expand = expansion(mult = c(0, 0.02))) +
      theme_pub() +
      labs(y = "Relative Contribution (%)") +
      theme(axis.text.x  = element_blank(),
            axis.ticks.x = element_blank(),
            axis.title.x = element_blank(),
            strip.text   = element_text(size = strip_size, face = "bold", margin = margin(t = 3, b = 3)),
            panel.spacing = unit(5.5, "pt"))
    strip <- ggplot(d_strip, aes(x = sample, y = 1, fill = SampleType)) +
      geom_tile(colour = "white", linewidth = 0.15, show.legend = TRUE) +
      facet_wrap(~ function_id, scales = "free_x", nrow = 1) +
      scale_fill_manual(values = sub_cols, labels = sub_labs, drop = FALSE, name = "Substrate") +
      theme_void(base_size = 9) +
      theme(strip.text = element_blank(), panel.spacing = unit(5.5, "pt"),
            legend.title = element_text(face = "bold", size = rel(0.9)),
            legend.text = element_text(size = rel(0.85)), legend.key.size = unit(3.2, "mm"))
    rp <- patchwork::wrap_plots(main, strip, ncol = 1, heights = c(18, 1))
    if (length(f_r) < ncol)
      rp <- patchwork::wrap_plots(rp, patchwork::plot_spacer(), nrow = 1, widths = c(length(f_r), ncol - length(f_r)))
    rp
  })
  patchwork::wrap_plots(rows, ncol = 1) +
    patchwork::plot_layout(guides = "collect") +
    patchwork::plot_annotation(title = title)
}

