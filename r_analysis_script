perm_tests <- function(p, label, site) {
  p <- prune_taxa(taxa_sums(p) > 0, p); m <- data.frame(sample_data(p))
  do.call(rbind, lapply(c("bray", "wunifrac"), function(meth) {
    d <- phyloseq::distance(p, method = meth)
    set.seed(123); a <- adonis2(d ~ SampleType, data = m, permutations = 999)
    data.frame(site = site, version = label, distance = meth, n = nrow(m),
               n_natural_log = sum(m$SampleType == "Natural Log"), R2 = round(a[1, "R2"], 4),
               p = a[1, "Pr(>F)"], chance_R2 = round(1 / (nrow(m) - 1), 4))
  }))
}
merge_pair <- function(p, keep_lib, drop_lib) {
  otu <- as(otu_table(p), "matrix"); if (!taxa_are_rows(p)) otu <- t(otu)
  otu[, keep_lib] <- rowMeans(otu[, c(keep_lib, drop_lib)]); otu <- otu[, colnames(otu) != drop_lib]
  phyloseq(otu_table(otu, taxa_are_rows = TRUE), sample_data(p)[colnames(otu), ], tax_table(p), phy_tree(p))
}
