source ~/.bashrc
conda activate metagenomics
set -euo pipefail
ROOT="${ROOT:?set ROOT to the project directory on scratch}"

BASE=${ROOT}/shotgun_results
RAW=${BASE}/fastq_raw
CLEAN=${BASE}/02_clean
SAMPLES=(M50 M53 M54 M73 M76 M83 M93 M94)
mkdir -p ${CLEAN}

ADAPT_NXT_1=CTGTCTCTTATACACATCT
ADAPT_NXT_2=AGATGTGTATAAGAGACAG
ADAPT_TRU_1=AGATCGGAAGAGCACACGTCTGAACTCCAGTCA
ADAPT_TRU_2=AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGT

trim() {  # trim <sample> <adapter_R1> <adapter_R2>
  local s=$1
  if [[ -s ${CLEAN}/${s}_clean_1.fastq.gz && -s ${CLEAN}/${s}_clean_2.fastq.gz ]]; then
    echo "[SKIP] ${s}: trimmed reads exist"
    return 0
  fi
  echo "[fastp] ${s} $(date)"
  fastp \
    -i ${RAW}/${s}_1.fastq.gz \
    -I ${RAW}/${s}_2.fastq.gz \
    -o ${CLEAN}/${s}_clean_1.fastq.gz \
    -O ${CLEAN}/${s}_clean_2.fastq.gz \
    --adapter_sequence $2 \
    --adapter_sequence_r2 $3 \
    -q 20 -u 30 -n 5 -l 50 \
    --thread 16 \
    --html ${CLEAN}/${s}.fastp.html \
    --json ${CLEAN}/${s}.fastp.json
}

for s in M50 M53 M54 M76 M83 M93 M94; do
  trim ${s} ${ADAPT_NXT_1} ${ADAPT_NXT_2}
done

trim M73 ${ADAPT_TRU_1} ${ADAPT_TRU_2}

for s in "${SAMPLES[@]}"; do
  if [[ -s ${CLEAN}/${s}_cat.fastq.gz ]]; then
    echo "[SKIP] ${s}_cat.fastq.gz exists"
    continue
  fi
  cat ${CLEAN}/${s}_clean_1.fastq.gz \
      ${CLEAN}/${s}_clean_2.fastq.gz \
      > ${CLEAN}/${s}_cat.fastq.gz
done
echo "[02_fastp_trim DONE] $(date)"

