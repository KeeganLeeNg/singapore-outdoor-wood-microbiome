variant <- function(lab, keep) {
  ps_r <- prune_samples(keep, ps_rare); ps_r <- prune_taxa(taxa_sums(ps_r) > 0, ps_r); m <- meta(ps_r)
  out <- list()
  for (dn in c("bray", "wunifrac")) {
    d <- phyloseq::distance(ps_r, dn); a <- marg(d, m)
    out[[length(out) + 1]] <- data.frame(variant = lab, test = "marginal PERMANOVA", distance = dn, n = nrow(m),
      site_R2 = a["Location", "R2"], site_p = a["Location", "Pr(>F)"], substrate_R2 = a["SampleType", "R2"],
