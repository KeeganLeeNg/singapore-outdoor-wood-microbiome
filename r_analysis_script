pf <- function(D2, g) { n <- length(g); sst <- sum(D2) / (2 * n)
  ssw <- sum(sapply(split(seq_len(n), g), function(i) sum(D2[i, i]) / (2 * length(i))))
  c(F = ((sst - ssw) / 1) / (ssw / (n - 2)), R2 = (sst - ssw) / sst) }
exact_test <- function(d, grp) { D2 <- as.matrix(d)^2; grp <- as.character(grp); n <- length(grp)
  lv <- names(sort(table(grp))); k <- sum(grp == lv[1])
  obs <- pf(D2, grp); cmb <- combn(n, k)
  Fp <- apply(cmb, 2, function(i) { g <- rep(lv[2], n); g[i] <- lv[1]; pf(D2, g)["F"] })
  c(obs, p_exact = mean(Fp >= obs["F"] * (1 - 1e-10)), assignments = ncol(cmb), smallest_p = 1 / ncol(cmb)) }
