numbers_as_numbers <- function(wb, sheet, d, col) {
  j <- match(col, names(d)); x <- as.character(d[[col]])
  v <- suppressWarnings(as.numeric(x))
  ok <- !is.na(v) & grepl("^-?[0-9]*\\.?[0-9]+([eE][-+]?[0-9]+)?$", x) & (v == 0 | abs(v) >= 2.2250738585072014e-308)
  for (i in which(ok)) writeData(wb, sheet, v[i], startCol = j, startRow = i + 1, colNames = FALSE)
}
width_of <- function(d) {
  vapply(seq_along(d), function(j) {
    x <- vapply(d[[j]], function(v) if (is.null(v) || (length(v) == 1 && is.na(v))) "NA" else as.character(v), character(1))
    min(60, max(8, nchar(names(d)[j]) + 2, ceiling(stats::quantile(nchar(x), 0.9, names = FALSE)) + 2))
  }, numeric(1))
}
