  rdA  <- function(f) read.csv(path.expand(file.path(AMPR, f)), check.names = FALSE, stringsAsFactors = FALSE)
  beta <- rdA("S8_BetaDiversity_PERMANOVA_PERMDISP_AllDistances.csv")
  bc   <- beta[beta$Kingdom == "Bacteria" & beta$Distance == "BrayCurtis", , drop = FALSE]
  hubt <- rdA("S27c_HubIndex_Taxa_Status.csv")
  coh  <- rdA("S15_ShotgunCohort_on_Current_HubIndex.csv")
  stopifnot(nrow(bc) == 1, nrow(hubt) == 6, all(COHORT$amplicon %in% coh$Sample))

  tab <- read.delim(path.expand(AMP_BACT_TABLE), sep = "\t", check.names = FALSE, stringsAsFactors = FALSE)
  attempted <- c(COHORT$amplicon, SHOTGUN_NOT_SEQUENCED)
  stopifnot(all(attempted %in% colnames(tab)))
  genus <- vapply(strsplit(tab$Taxonomy, ";", fixed = TRUE),
                  function(x) if(length(x) >= 6) trimws(sub("^g__", "", x[6])) else NA_character_, "")
  cnt   <- as.matrix(tab[, attempted, drop = FALSE])
  genus_reads <- function(g){
    hit <- !is.na(genus) & (genus == g | startsWith(genus, paste0(g, "-")))
    list(reads = colSums(cnt[hit, , drop = FALSE]), label = paste(sort(unique(genus[hit])), collapse = " / ")) }
  reads_txt <- function(v, what){
    if(sum(v) == 0) return(sprintf("no read assigned to %s", what))
    nz <- v[v > 0]
    sprintf("%s read%s assigned to %s (%s)", format(sum(v), big.mark = ","), if(sum(v) == 1) "" else "s", what,
            paste(sprintf("%s: %s", names(nz), format(nz, big.mark = ",", trim = TRUE)), collapse = ", ")) }
  es <- genus_reads("Escherichia"); ur <- genus_reads("Ureaplasma")
  es_lab <- if(nzchar(es$label)) es$label else "Escherichia"
  es_seq <- es$reads[COHORT$amplicon]; es_not <- es$reads[SHOTGUN_NOT_SEQUENCED]
  ur_seq <- ur$reads[COHORT$amplicon]
  depth  <- colSums(cnt)[COHORT$amplicon]

  fam <- hubt[hubt$Rank == "family", , drop = FALSE]; gen <- hubt[hubt$Rank == "genus", , drop = FALSE]
  n_tested <- hubt$ANCOMBC2_families_tested[1]; n_robust <- hubt$ANCOMBC2_families_diff_robust[1]
  fam_status <- vapply(seq_len(nrow(fam)), function(i){
    if(fam$ASVs[i] == 0) return("absent from the current survey tables")
    if(!isTRUE(as.logical(fam$ANCOMBC2_tested[i]))) return("present, but below the ANCOM-BC2 prevalence cut (not tested)")
    sprintf("ANCOM-BC2 q = %s, diff_robust = %s (%d of %d families tested pass the sensitivity screen)",
            formatC(fam$ANCOMBC2_q[i], format = "g", digits = 2), isTRUE(as.logical(fam$ANCOMBC2_diff_robust[i])), n_robust, n_tested) }, "")
  gen_status <- vapply(seq_len(nrow(gen)), function(i){
    if(gen$ASVs[i] == 0) return("absent from the current survey tables")
    sprintf("Zi-Pi role in the bacterial genus network: %s (natural log), %s (processed wood)",
            gen$ZiPi_Role_NaturalLog[i], gen$ZiPi_Role_ProcessedWood[i]) }, "")
  n_idx_robust <- sum(as.logical(fam$ANCOMBC2_diff_robust) %in% TRUE)

  list(
    n = bc$n, loc_r2 = bc$Location_R2, sub_r2 = bc$SampleType_R2,
    hub_taxa = hubt, hub_status = setNames(c(fam_status, gen_status), c(fam$Taxon, gen$Taxon)),
    hub_verdict = sprintf("%d of %d families tested by ANCOM-BC2 pass its sensitivity screen (diff_robust), %s of the three index families among them; Zi-Pi roles of the three index genera (natural log / processed wood): %s",
                          n_robust, n_tested, if(n_idx_robust == 0) "none" else as.character(n_idx_robust),
                          paste(sprintf("%s %s / %s", gen$Taxon, gen$ZiPi_Role_NaturalLog, gen$ZiPi_Role_ProcessedWood), collapse = "; ")),
    idx_selects_sequenced = sum(as.logical(coh$Sequenced) & as.logical(coh$Selected_by_current_index)),
    depth = depth,
    depth_txt = sprintf("%s-%s", format(min(depth), big.mark = ","), format(max(depth), big.mark = ",")),
    esch_label = es_lab,
    esch_seq_txt = reads_txt(es_seq, es_lab),
    esch_not_txt = if(sum(es_not) == 0) "" else { nz <- es_not[es_not > 0]
      sprintf(" (the three samples whose libraries failed QC hold %s, in %s)", format(sum(nz), big.mark = ","),
              if(length(nz) == 1) names(nz) else paste(sprintf("%s (%s)", names(nz), format(nz, big.mark = ",", trim = TRUE)), collapse = ", ")) },
    urea_reads = sum(ur_seq),
    urea_support = if(sum(ur_seq) == 0) "zero support in the 16S data" else sprintf("%d 16S reads in the same samples", sum(ur_seq)),
    urea_short   = if(sum(ur_seq) == 0) "zero 16S support" else sprintf("%d 16S reads", sum(ur_seq)))
})
