save_gg <- function(plot_obj, section, tag, width = 10, height = 7) {
  key   <- paste0("S", section, "_", tag)
  fname <- file.path(output_dir, paste0(key, ".png"))
  plot_obj <- tryCatch(plot_obj + ggplot2::labs(title = NULL, subtitle = NULL, caption = NULL),
                       error = function(e) plot_obj)
  if (inherits(plot_obj, "ggplot") && !inherits(plot_obj, "patchwork")) {
    g <- ggplot2::ggplotGrob(plot_obj)
    png(fname, width = width, height = height, units = "in", res = 300, bg = "white")
    grid::grid.newpage(); grid::grid.draw(g); dev.off()
    save_grob_rds(g, output_dir, key)
  } else {
    ggsave(fname, plot = plot_obj, width = width, height = height,
           dpi = 300, bg = "white")
  }
  cat(paste0("[SAVED] ", basename(fname), "\n"))
  invisible(fname)
}

