  put("RECRUIT_MEAN",    f1(mean(rec$pct_to_kept_MAGs)))
  put("RECRUIT_MEAN2",   f2(mean(rec$pct_to_kept_MAGs)))
  put("RECRUIT_BEFORE",  f1(mean(rec$pct_to_kept_MAGs + cab[rec$id])))
  put("RECRUIT_BEFORE2", f2(mean(rec$pct_to_kept_MAGs + cab[rec$id])))
  put("M50_AFTER",  f2(rec$pct_to_kept_MAGs[rec$id == "M50"]))
  put("M50_BEFORE", f2(rec$pct_to_kept_MAGs[rec$id == "M50"] + cab[["M50"]]))
  put("M50_CONTAM_SHARE", sprintf("%.0f", 100 * cab[["M50"]] / (rec$pct_to_kept_MAGs[rec$id == "M50"] + cab[["M50"]])))
  put("FAINTEST", format(rd("M6_detection_floor.csv")$faintest_recovered_MAG_pct))

  bl5 <- tryCatch(rd("M5_bacterial_lignin_markers.csv"), error = function(e) NULL)
  lig <- bl5$bin[bl5[["Ring meta-cleavage (Lig)"]] == length(LIG_MCLEAVAGE_KOS)]
  put("LIG_COMPLETE", length(lig))
  if(length(lig) && !is.null(q)){
    tx  <- q[match(lig, q$bin), c("order", "genus")]
    top <- names(sort(table(tx$order), decreasing = TRUE))[1]
    put("LIG_TOP_ORDER",  top)
    put("LIG_TOP_N",      sum(tx$order == top, na.rm = TRUE))
    put("LIG_TOP_GENERA", paste(sort(unique(tx$genus[tx$order %in% top & !is.na(tx$genus) & nzchar(tx$genus)])), collapse = ", ")) }
  mco <- bl5[["Multicopper oxidase / laccase"]]
  put("MCO_N",         sum(mco > 0))
  put("MCO_PERGENOME", if(max(mco) <= 1) "at one KO each" else sprintf("at up to %d KOs each", max(mco)))
  put("DYP_N",         sum(bl5[["Peroxidase (DyP)"]] > 0))
  put("FUNGAL_CTRL_N", sum(bl5[["Fungal class-II peroxidase"]] > 0))

  ts  <- tryCatch(rd("M6b_bacmet_threshold_sensitivity.csv"), error = function(e) NULL)
  med <- function(cat, p) format(ts$median_per_MAG[ts$category == cat & ts$pid_threshold == p])
  for(p in c(40, 50, 70)){ put(sprintf("TOL_MED_%d_CU", p), med("copper", p)); put(sprintf("TOL_MED_%d_EF", p), med("efflux", p)) }
  ct  <- tryCatch(rd("M6_catabolism_tolerance.csv"), error = function(e) NULL)
