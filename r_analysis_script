coverm_mat <- function(f, keepbins){ if(!file.exists(f)) return(NULL); x<-read.delim(f,check.names=FALSE)
colnames(x)[1]<-"bin"; x$bin<-sub("\\.fa$","",x$bin)
cn<-sub(" .*$","",colnames(x)[-1]); cn<-sub("[._]sorted.*$","",cn); cn<-sub("\\..*$","",cn)
cn<-ifelse(grepl("^M",cn),cn,paste0("M",cn)); colnames(x)[-1]<-cn
x %>% filter(bin %in% keepbins) %>% column_to_rownames("bin") %>% as.matrix() }

coverm_recruitment <- function(f, keepbins){
  if(!file.exists(f)) return(NULL)
  x <- read.delim(f, check.names = FALSE); colnames(x)[1] <- "bin"
  x$bin <- sub("\\.fa$", "", x$bin)
  cn <- sub(" .*$", "", colnames(x)[-1]); cn <- sub("[._]sorted.*$", "", cn); cn <- sub("\\..*$", "", cn)
  cn <- ifelse(grepl("^M", cn), cn, paste0("M", cn)); colnames(x)[-1] <- cn
  is_un <- grepl("^unmapped$", x$bin, ignore.case = TRUE)
  if(!any(is_un)) return(NULL)
  unmapped <- x[is_un, -1, drop = FALSE]
  retained <- x[!is_un & x$bin %in% keepbins, -1, drop = FALSE]
  tibble(id = colnames(unmapped),
         pct_unmapped      = as.numeric(unmapped[1, ]),
         pct_to_all_bins   = 100 - as.numeric(unmapped[1, ]),
         pct_to_kept_MAGs  = colSums(retained)) }

association <- function(A, B, label, k=2, perms=9999){
  samp<-intersect(colnames(A),colnames(B)); fA<-rownames(A); fB<-rownames(B); sh<-intersect(fA,fB); U<-union(fA,fB)
  Af<-matrix(0,length(U),length(samp),dimnames=list(U,samp)); Bf<-Af; Af[fA,samp]<-A[,samp]; Bf[fB,samp]<-B[,samp]
  rho<-sapply(samp,function(s){keep<-rownames(Af)%in%sh; if(sum(keep)<3) NA_real_ else suppressWarnings(cor(Af[keep,s],Bf[keep,s],method="spearman"))})
  dA<-vegdist(t(Af),"bray"); dB<-vegdist(t(Bf),"bray")
  pt<-seeded(protest(cmdscale(dA,k),cmdscale(dB,k),permutations=perms))
  mn<-seeded(vegan::mantel(dA,dB,method="spearman",permutations=perms))
  list(shared=sh, proc=pt, Af=Af, Bf=Bf,
       stats=tibble(comparison=label, shared=length(sh), amplicon_only=length(setdiff(fA,fB)), shotgun_only=length(setdiff(fB,fA)),
                    procrustes_M2=round(pt$ss,3), procrustes_r=round(pt$t0,3), protest_p=pt$signif,
                    mantel_r=round(mn$statistic,3), mantel_p=mn$signif, spearman_med=round(median(rho,na.rm=TRUE),3))) }
lin_ccc <- function(x, y){ mx<-mean(x); my<-mean(y); vx<-var(x); vy<-var(y); cxy<-cov(x,y); 2*cxy/(vx+vy+(mx-my)^2) }
agreement <- function(assoc){ sh<-assoc$shared; A<-assoc$Af[sh,,drop=FALSE]; B<-assoc$Bf[sh,,drop=FALSE]
pts<-tibble(feature=rep(rownames(A),ncol(A)), amp=as.vector(A), shot=as.vector(B)) %>% filter(amp>0, shot>0) %>%
  mutate(lx=log10(amp), ly=log10(shot), avg=(lx+ly)/2, diff=ly-lx)
ccc<-lin_ccc(pts$lx, pts$ly); bias<-mean(pts$diff); loa<-1.96*sd(pts$diff)
list(points=pts, ccc=round(ccc,3), bias=round(bias,3), loa_lower=round(bias-loa,3), loa_upper=round(bias+loa,3)) }

permanova_report <- function(d, meta, label, drop_id = "M73"){
  ids <- labels(d); if(is.null(ids)) ids <- rownames(as.matrix(d))
  one <- function(dd, mm, tag){
    pm <- seeded(adonis2(dd ~ substrate + site, data = mm, by = "margin", permutations = 9999))
    bd <- tryCatch(anova(betadisper(dd, droplevels(mm$substrate)))$`Pr(>F)`[1], error = function(e) NA_real_)
    fl <- perm_floor(mm$substrate)
    tibble(analysis = label, subset = tag, n = nrow(mm),
           substrate_R2 = round(pm$R2[1], 3), substrate_p = pm$`Pr(>F)`[1],
           site_R2 = round(pm$R2[2], 3), site_p = pm$`Pr(>F)`[2],
           betadisper_p = round(bd, 3), n_label_assignments = fl$n_assignments,
           p_floor = round(fl$p_floor, 4)) }
  m  <- meta[match(ids, meta$id), ]
  out <- one(d, m, "all 8 samples")
  if(drop_id %in% ids){
    k  <- setdiff(ids, drop_id); dm <- as.matrix(d)
    out <- bind_rows(out, one(as.dist(dm[k, k]), meta[match(k, meta$id), ],
                              paste0("drop ", drop_id, " (only TruSeq Nano library)"))) }
  out %>% mutate(caveat = "betadisper at n<=8 has minimal power; a non-significant dispersion test does not secure the location interpretation") }

