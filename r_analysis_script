marg <- function(p, label) {
  p <- prune_taxa(taxa_sums(p) > 0, p); m <- data.frame(sample_data(p))
  do.call(rbind, lapply(c("bray", "wunifrac"), function(meth) {
    d <- phyloseq::distance(p, method = meth)
    set.seed(123); a <- adonis2(d ~ Location + SampleType, data = m, permutations = 999, by = "margin")
    data.frame(version = label, distance = meth, n = nrow(m), site_R2 = round(a["Location", "R2"], 4),
               site_p = a["Location", "Pr(>F)"], substrate_R2 = round(a["SampleType", "R2"], 4),
               substrate_p = a["SampleType", "Pr(>F)"])
  }))
}
