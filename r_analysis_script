lm_over_instances <- function(x, mm, coef) {
  mc <- getMonteCarloInstances(x); k <- numMCInstances(x)
  qrX <- qr(mm); dof <- nrow(mm) - qrX$rank
  if (qrX$rank < ncol(mm)) stop("model matrix is rank-deficient", call. = FALSE)
  XtXinv <- chol2inv(qr.R(qrX))[order(qrX$pivot), order(qrX$pivot)]
  j <- which(colnames(mm) == coef)
  acc <- list(est = 0, p_gt = 0, p_lt = 0, bh_gt = 0, bh_lt = 0, ho_gt = 0, ho_lt = 0)
  for (i in seq_len(k)) {
    Y  <- t(sapply(mc, function(m) m[, i]))
    B  <- qr.coef(qrX, Y); R <- qr.resid(qrX, Y)
    se <- sqrt(colSums(R^2) / dof * XtXinv[j, j])
    p1 <- pt(B[j, ] / se, df = dof, lower.tail = FALSE)
    acc$est   <- acc$est + B[j, ]
    acc$p_gt  <- acc$p_gt + pmin(2 * p1, 1);       acc$p_lt  <- acc$p_lt + pmin(2 * (1 - p1), 1)
    acc$bh_gt <- acc$bh_gt + p.adjust(2 * p1, "BH"); acc$bh_lt <- acc$bh_lt + p.adjust(2 * (1 - p1), "BH")
    acc$ho_gt <- acc$ho_gt + p.adjust(2 * p1, "holm"); acc$ho_lt <- acc$ho_lt + p.adjust(2 * (1 - p1), "holm")
  }
  data.frame(feature = rownames(mc[[1]]), Est = acc$est / k, p = pmin(acc$p_gt, acc$p_lt) / k,
             BH = pmin(acc$bh_gt, acc$bh_lt) / k, Holm = pmin(acc$ho_gt, acc$ho_lt) / k, row.names = NULL)
}
