  put("KO_INFLATION",        sprintf("%.0f", ko$pct_of_shotgun_repertoire_shotgun_only / ko$pct_of_shotgun_repertoire_beyond_16S_reach))

  tc <- tryCatch(rd("M3_taxonomic_concordance_stats.csv"), error = function(e) NULL)
  cmp <- function(lbl) tc[tc$comparison == lbl, , drop = FALSE]
  bb <- cmp("Bacteria: 16S vs Bracken"); bm4 <- cmp("Bacteria: 16S vs MetaPhlAn 4")
  put("BACT_BRACKEN_CCC", f2(bb$lin_ccc));  put("BACT_MPA_CCC",   f2(bm4$lin_ccc))
  put("BACT_M2",          f2(bb$procrustes_M2))
  put("BACT_PROTEST_P",   if(bb$protest_p < 0.001) "<0.001" else paste0("=", f3(bb$protest_p)))
  put("PATH_CCC",   f2(rd("M8_pathway_concordance_stats.csv")$lin_ccc))

  kr <- tryCatch(do.call(rbind, lapply(COHORT$id, function(i){
    k   <- read.delim(file.path(KRAKEN_DIR, paste0(i, "_kraken_report.txt")), header = FALSE, stringsAsFactors = FALSE, quote = "")
    tot <- sum(k[[2]][k[[5]] %in% c(0, 1)])
    b   <- read.delim(file.path(KRAKEN_DIR, paste0(i, "_bracken_G.tsv")), stringsAsFactors = FALSE, quote = "")
    e   <- b[trimws(b$name) == "Escherichia", ]; u <- b[trimws(b$name) == "Ureaplasma", ]
    data.frame(id = i, chordata = sum(k[[1]][k[[5]] == 7711]),
               esch_g   = 100 * sum(e$fraction_total_reads),
               esch_all = 100 * sum(e$new_est_reads) / tot,
               urea_g   = 100 * sum(u$fraction_total_reads), stringsAsFactors = FALSE) })), error = function(e) NULL)
  put("CHORDATA_MEAN",  f1(mean(kr$chordata)))
  put("CHORDATA_RANGE", sprintf("%.1f-%.1f", min(kr$chordata), max(kr$chordata)))
  put("ESCH_MIN_G",   f2(min(kr$esch_g)));   put("ESCH_MAX_G",   f2(max(kr$esch_g)))
  put("ESCH_MIN_ALL", f2(min(kr$esch_all))); put("ESCH_MAX_ALL", f2(max(kr$esch_all)))
  put("ESCH_MAX_LIB",     kr$id[which.max(kr$esch_g)])
  put("ESCH_MAX_LIB_ALL", f2(kr$esch_all[which.max(kr$esch_g)]))
  put("UREA_MAX", f2(max(kr$urea_g))); put("UREA_N", sum(kr$urea_g > 0))

  put("CH2_N",        CH2$n)
  put("CH2_LOC_R2",   f3(CH2$loc_r2));  put("CH2_SUB_R2", f3(CH2$sub_r2))
  put("AMP16S_DEPTH", CH2$depth_txt)
  put("ESCH_16S_SEQ", CH2$esch_seq_txt)
  put("ESCH_16S_NOT", CH2$esch_not_txt)
  put("UREA_16S_SUPPORT", CH2$urea_support); put("UREA_16S_SHORT", CH2$urea_short)
  put("HUBIDX_VERDICT", CH2$hub_verdict)
  put("HUBIDX_SEQ_SELECTED", CH2$idx_selects_sequenced)
  pfmt <- function(p) if(p < 0.001) "<0.001" else paste0("=", f3(p))
  put("MPA_M2",  f2(bm4$procrustes_M2)); put("MPA_PROTEST_P",   pfmt(bm4$protest_p))
  put("PICRUST_NSTI", f2(mean_nsti))
  eh <- tryCatch(readLines(file.path(SHOT, "eggnog_catalogue.emapper.annotations"), n = 10, warn = FALSE), error = function(e) character(0))
