      {
        vals <- across(all_of(substrate_cols)) / row_sum
        1 / rowSums(vals^2)
      }
    ),
    Ba = (Levins_B - 1) / (N_niches - 1),
    Ba = pmax(0, pmin(1, Ba)),
    Ecological_Role = case_when(
      is.na(Ba)   ~ NA_character_,
      Ba < 0.25   ~ "Specialist",
      Ba > 0.75   ~ "Generalist",
      TRUE        ~ "Intermediate"
