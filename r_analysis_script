save_panel <- function(plot, file, width_mm = FEMS_W["single"], height_mm = 80,
                       dpi = 600, dir = ".") {
  if (inherits(plot, "ggplot")) plot <- plot + labs(title = NULL, subtitle = NULL)
  if (!dir.exists(dir)) dir.create(dir, recursive = TRUE, showWarnings = FALSE)
  path <- file.path(dir, file)
  ggsave(path, plot = plot, width = as.numeric(width_mm),
         height = as.numeric(height_mm), units = "mm", dpi = dpi, bg = "white",
         limitsize = FALSE)
  message("[panel] ", path, "  (", round(width_mm), " x ", round(height_mm),
          " mm @ ", dpi, " dpi)")
  invisible(path)
}

