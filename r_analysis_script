    if(!is.null(g) && nrow(g) == 1 && !is.null(bk)){
      cand <- bk %>% filter(contig == r$contig) %>%
        mutate(ov = pmax(0, pmin(stop, max(g$gstart, g$gend)) - pmax(start, min(g$gstart, g$gend)) + 1),
               frac = ov / pmin(stop - start + 1, abs(g$gend - g$gstart) + 1)) %>% filter(frac >= 0.5) %>% arrange(desc(ov))
      if(nrow(cand)) { loc <- cand$locus[1]; prod <- cand$product[1] } }
    ko <- if(!is.na(loc) && !is.null(kf)) kf$KO[kf$locus == loc] else character(0)
    kcall <- if(is.na(loc)) "no matching Bakta protein" else if(length(ko))
      sprintf("%s (%s; Bakta %s)", paste(ko, collapse = ","), .lc1(prod), loc) else
      sprintf("no KO assigned (Bakta %s)", loc)
    bl <- if(!is.null(.blastp) && !is.na(loc)) .blastp[.blastp$qseqid == loc, , drop = FALSE] else NULL
    bcall <- if(!is.null(bl) && nrow(bl)) with(bl[1, ], sprintf("%.1f%% identity, %d-column alignment over residues %d-%d of %d (query %d-%d of %d); e = %s; blastp 2.12.0",
               pident, length, sstart, send, slen, qstart, qend, qlen, formatC(evalue, format = "e", digits = 1))) else "not tested"
    sc <- .genomad_scores(b); sc <- if(!is.null(sc)) sc[sc$seq_name == r$contig, , drop = FALSE] else NULL
    is_el <- read_is(b); is_el <- if(!is.null(is_el)) is_el[is_el$contig == r$contig, , drop = FALSE] else NULL
    ig <- .integron_spans(b); ig <- ig[ig$contig == r$contig, , drop = FALSE]
    n_ig <- function(t) sum(ig$type == t)
    vi <- .virus_spans(b); vi <- vi[vi$contig == r$contig, , drop = FALSE]
    on_plasmid <- r$contig %in% read_plasmid(b)
    lo <- if(!is.null(g) && nrow(g) == 1) min(g$gstart, g$gend) else -Inf
    hi <- if(!is.null(g) && nrow(g) == 1) max(g$gstart, g$gend) else  Inf
    hit_el <- any(vi$vs <= hi & vi$ve >= lo) ||
              (!is.null(is_el) && any(is_el$es <= hi & is_el$ee >= lo)) || any(ig$es <= hi & ig$ee >= lo)
    tibble(KofamScan_call = kcall, blastp_vs_PcpA_Q9ZBB0 = bcall,
           geNomad_plasmid_score = if(!is.null(sc) && nrow(sc)) sprintf("%.4f", sc$plasmid_score[1]) else "not reported",
           geNomad_virus_score   = if(!is.null(sc) && nrow(sc)) sprintf("%.4f", sc$virus_score[1])   else "not reported",
           ISEScan_IS_elements   = if(is.null(is_el) || !nrow(is_el)) "none" else paste(sprintf("%s (%d-%d)", sub("^IS:", "", is_el$elem), is_el$es, is_el$ee), collapse = "; "),
           IntegronFinder_calls  = sprintf("%d complete, %d In0, %d CALIN", n_ig("complete"), n_ig("In0"), n_ig("CALIN")),
           screened = TRUE, mobile = on_plasmid || isTRUE(hit_el)) })
  cat_pres <- bind_cols(cat_pres, screen)
  .ENZ_RX <- c(K15242 = "dichloro-?p?-?hydroquinone|pcpA", K03391 = "pentachlorophenol|pcpB",
               K15241 = "tetrachloro-?p?-?hydroquinone|pcpC", K15236 = "hexachlorocyclohexane|lindane|dehydrochlorinase|linA")
  stopifnot(setequal(names(.ENZ_RX), names(.PRES_GENE)))
  cat_pres <- cat_pres %>%
    mutate(eggNOG_description_names_the_enzyme =
             ifelse(mapply(function(k, d) grepl(.ENZ_RX[[k]], d, ignore.case = TRUE), KO, eggnog_description), "yes", "no"),
           .after = eggnog_description)
  cat("[mod6] catalogue copies whose eggNOG description names the enzyme: ",
      sum(cat_pres$eggNOG_description_names_the_enzyme == "yes"), " of ", nrow(cat_pres), "\n", sep = "")
  write.csv(cat_pres %>% select(-screened, -mobile), file.path(TAB, "M6_preservative_catalogue_copies.csv"), row.names = FALSE)
  cat("[mod6] Table S17: ", nrow(cat_pres), " catalogue copies (", paste(names(table(cat_pres$bin_status)), table(cat_pres$bin_status), sep = " ", collapse = "; "),
      "); screened ", sum(cat_pres$screened), ", on a mobile element ", sum(cat_pres$mobile), "\n", sep = "")
}
