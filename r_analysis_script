classify_tol <- function(gene){
  g <- tolower(trimws(gene))
  dplyr::case_when(tol_any(g, COPPER_TOL) ~ "copper",
                   tol_any(g, EFFLUX_TOL) ~ "efflux",
                   TRUE ~ "unclassified") }
