    if(inherits(x, "text")) out <<- c(out, as.character(x$label))
    if(inherits(x, "EulerTag")) out <<- c(out, as.character(x$label_text), as.character(x$quantity_text))
    if(inherits(x, "gTree")) for(ch in x$children) walk(ch) }
  walk(g); unique(out[!is.na(out)]) }
.check_euler_text <- function(g, expected){ tx <- .grob_text(g)
