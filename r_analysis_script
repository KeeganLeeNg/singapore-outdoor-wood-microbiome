fig_stat <- function(figure, panel = "", statistic = "", value = NA,
                     p = NA, n = NA, test = "", source = "", note = "") {
  row <- data.frame(
    figure = figure, panel = panel, statistic = statistic,
    value = as.character(value), p = as.character(p), n = as.character(n),
    test = test, source = source, note = note, stringsAsFactors = FALSE)
  .fig_stats_env$tbl <- rbind(.fig_stats_env$tbl, row)
  invisible(row)
}

reset_fig_stats <- function() .fig_stats_env$tbl <- data.frame()

write_fig_stats_xlsx <- function(path) {
  if (!requireNamespace("writexl", quietly = TRUE)) {
    csv <- sub("\\.xlsx$", ".csv", path)
    warning("writexl not installed; writing figure stats to ", csv,
            " instead. Run install.packages('writexl') once, interactively.")
    utils::write.csv(.fig_stats_env$tbl, csv, row.names = FALSE)
    return(invisible(csv))
  }
  tbl <- .fig_stats_env$tbl
  if (nrow(tbl) == 0) { message("No figure statistics logged yet."); return(invisible()) }
  sheets <- split(tbl, factor(tbl$figure, levels = unique(tbl$figure)))
  names(sheets) <- substr(gsub("[\\\\/?*:\\[\\]]", "-", names(sheets)), 1, 31)
  writexl::write_xlsx(sheets, path)
  message("[stats] wrote ", length(sheets), " figure sheets -> ", path)
  invisible(path)
}

