bracken_matrix <- function(dom){
  purrr::map_dfr(COHORT$id, function(id) read.delim(file.path(KRAKEN_DIR,paste0(id,"_bracken_G.tsv")),stringsAsFactors=FALSE) %>%
                   transmute(taxid=as.character(taxonomy_id), genus=clean_genus(name), frac=fraction_total_reads, reads=new_est_reads, id=id)) %>%
    left_join(domain_map,by="taxid") %>% filter(domain==dom, !is.na(genus)) %>%
    group_by(id,genus) %>% summarise(frac=sum(frac), reads=sum(reads), .groups="drop") %>%
    group_by(id) %>% mutate(frac = if(sum(frac)>0) frac/sum(frac) else frac) %>% ungroup() %>%
    mutate(frac = ifelse(reads >= MIN_READS & frac >= MIN_FRAC, frac, 0)) %>%
    group_by(id) %>% mutate(frac = if(sum(frac)>0) frac/sum(frac) else frac) %>% ungroup() %>%
    filter(frac > 0) %>% select(id,genus,frac) %>%
    pivot_wider(names_from=id,values_from=frac,values_fill=0) %>% column_to_rownames("genus") %>%
    as.matrix() %>% (\(m) m[,COHORT$id,drop=FALSE])() }
