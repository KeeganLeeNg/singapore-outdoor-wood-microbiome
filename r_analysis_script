KO_BREADTH_MIN <- 800

ko_from_kofam <- function(binset){
  purrr::map_dfr(binset, function(b){
    f <- file.path(SHOT, "12_xenobiotic", paste0(b, "_kofam.txt"))
    if(!file.exists(f) || file.size(f) == 0) return(NULL)
    ln <- readLines(f, warn = FALSE); ln <- ln[nzchar(ln)]
    tibble(bin = b, KO = toupper(sub("^[^\t]*\t?", "", ln))) %>% filter(grepl("^K[0-9]{5}$", KO)) }) }

egg_cols <- function(f, cols){
  cut_ok <- tryCatch(nzchar(Sys.which("cut")), error = function(e) FALSE)
  if(cut_ok){
    cmd <- paste("cut -f", paste(cols, collapse=","), " ", shQuote(path.expand(f)), sep="")
    out <- tryCatch(read.delim(pipe(cmd), comment.char = "#", header = FALSE,
                               quote = "", stringsAsFactors = FALSE,
                               colClasses = "character"),
                    error = function(e) NULL)
    if(!is.null(out) && ncol(out) == length(cols)) return(out)
  }
  read.delim(f, comment.char = "#", header = FALSE, quote = "",
             stringsAsFactors = FALSE, colClasses = "character")[, cols, drop = FALSE] }

ko_from_eggnog <- function(binset, s2b_tbl){
  f <- file.path(SHOT, "eggnog_catalogue.emapper.annotations")
  if(!file.exists(f)) return(NULL)
  e <- egg_cols(f, c(1, 12))
  tibble(gene = as.character(e[[1]]), kos = as.character(e[[2]])) %>%
    mutate(contig = sub("_[0-9]+$", "", gene)) %>%
    inner_join(s2b_tbl, by = "contig") %>% filter(bin %in% binset) %>%
    separate_rows(kos, sep = ",") %>% mutate(KO = kclean(kos)) %>%
    filter(grepl("^K[0-9]{5}$", KO)) %>% select(bin, KO) %>% distinct() }

pick_ko_source <- function(binset, s2b_tbl){
  kf <- tryCatch(ko_from_kofam(binset), error = function(e) NULL)
  kf_breadth <- if(is.null(kf) || !nrow(kf)) 0L else n_distinct(kf$KO)
  eg <- if(kf_breadth < KO_BREADTH_MIN) tryCatch(ko_from_eggnog(binset, s2b_tbl), error = function(e) NULL) else NULL
  eg_breadth <- if(is.null(eg) || !nrow(eg)) 0L else n_distinct(eg$KO)
  ctrl_in_kofam <- if(kf_breadth) any(FUNGAL_CLASSII_KOS %in% kf$KO) else FALSE
  targeted <- kf_breadth > 0 && kf_breadth < KO_BREADTH_MIN
  use_egg  <- targeted && eg_breadth >= KO_BREADTH_MIN
  src <- if(kf_breadth == 0 && eg_breadth > 0) "eggNOG (no kofam output found)" else
         if(use_egg) "eggNOG (kofam appears to be a targeted screen)" else
         if(kf_breadth > 0) "kofam" else "none"
  diag <- tibble(source_used = src, kofam_distinct_KOs = kf_breadth, eggnog_distinct_KOs = eg_breadth,
                 breadth_threshold = KO_BREADTH_MIN, kofam_looks_targeted = targeted,
                 fungal_controls_detected_in_kofam = ctrl_in_kofam,
                 warning = if(targeted && !use_egg)
                   "kofam looks targeted AND eggNOG fallback unavailable — the F5d panel and its negative control are NOT trustworthy; see the console note"
                 else if(use_egg) "rebuilt from eggNOG because kofam breadth was too low to have searched the full panel"
                 else "kofam breadth is consistent with whole-genome annotation")
  write.csv(diag, file.path(TAB, "M5_lignin_panel_source.csv"), row.names = FALSE)
  if(targeted && !use_egg){
    warning("F5d COVERAGE PROBLEM: only ", kf_breadth, " distinct KOs in the kofam output. ",
            "That is consistent with a targeted xenobiotic screen, in which case K15733/K14588/K00421/K05909/K22552 ",
            "and BOTH fungal controls (K20205, K23515) were never searched and their zeros are meaningless. ",
            "Re-run KOfam over the full panel before using F5d.") }
  list(ko = if(use_egg || kf_breadth == 0) eg else kf, source = src, diag = diag) }

