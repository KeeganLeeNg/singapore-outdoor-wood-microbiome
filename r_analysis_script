pf <- function(D2, g) { n <- length(g); sst <- sum(D2) / (2 * n)
  ssw <- sum(sapply(split(seq_len(n), g), function(i) sum(D2[i, i]) / (2 * length(i))))
  c(F = ((sst - ssw) / 1) / (ssw / (n - 2)), R2 = (sst - ssw) / sst, ssw = ssw) }
assign_ssw <- function(D2, grp) {
  grp <- as.character(grp); n <- length(grp); lv <- names(sort(table(grp))); k <- sum(grp == lv[1])
  cmb <- combn(n, k); obs <- which(grp == lv[1])
  vals <- apply(cmb, 2, function(i) { g <- rep(lv[2], n); g[i] <- lv[1]; pf(D2, g)[["ssw"]] })
  list(obs = pf(D2, grp), all = vals, n = n) }
exact_site <- function(d, grp) { a <- assign_ssw(as.matrix(d)^2, grp)
  c(a$obs[c("F", "R2")], p_exact = mean(a$all <= a$obs[["ssw"]] * (1 + 1e-10)), assignments = length(a$all)) }
