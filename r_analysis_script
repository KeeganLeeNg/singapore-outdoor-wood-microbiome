verify_kos <- function(strict = TRUE){
  ref <- .p2 %>% select(ko, any_of(c("ko_name","ko_des"))) %>% distinct(ko, .keep_all = TRUE)
  if(!"ko_name" %in% names(ref)) ref$ko_name <- NA_character_
  if(!"ko_des"  %in% names(ref)) ref$ko_des  <- NA_character_
  chk <- KO_EXPECTATIONS %>% left_join(ref, by = c("KO" = "ko")) %>%
    mutate(found = !is.na(ko_des),
           matches = purrr::pmap_lgl(list(expect, ko_des, ko_name), function(p, d, n){
             if(is.na(p)) return(FALSE)
             hit <- function(x) !is.na(x) && grepl(p, x, ignore.case = TRUE)
             hit(d) || hit(n) }),
           status = case_when(!found ~ "ABSENT FROM REFERENCE LIST",
                              !matches ~ "MISMATCH - identifier does not describe what the code claims",
                              TRUE ~ "ok"))
  write.csv(chk %>% select(KO, panel, expected = expect, actual_symbol = ko_name,
                           actual_description = ko_des, status),
            file.path(TAB, "M0_KO_verification.csv"), row.names = FALSE)
  bad <- chk %>% filter(status != "ok")
  if(nrow(bad)){
    msg <- paste0("\n  ", bad$KO, "  [", bad$panel, "]  expected /", bad$expect,
                  "/ but list says: ", ifelse(is.na(bad$ko_des), "<absent>", bad$ko_des), collapse = "")
    if(strict) stop("KO verification failed against ", basename(KOLIST), ":", msg,
                    "\n  Fix the identifiers or call verify_kos(strict = FALSE) to proceed knowingly.\n")
    warning("KO verification issues:", msg) }
  cat("[verify] ", sum(chk$status == "ok"), "/", nrow(chk),
      " hard-coded KOs verified against ", basename(KOLIST), "\n", sep = "")
  invisible(chk) }
verify_kos()
