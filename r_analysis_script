  d1 <- eh[1]
  d2 <- suppressWarnings(format(as.Date(strptime(d1, "%a %b %d %H:%M:%S %Y", tz = "UTC")), "%Y-%m-%d"))
  put("EGGNOG_DATE", if(length(d2) && !is.na(d2)) d2 else d1)
  cmd <- eh[grepl("emapper\\.py", eh)][1]
  put("EGGNOG_FLAGS", paste(unique(regmatches(cmd, gregexpr("(?<=\\s)-{1,2}[A-Za-z_]+", cmd, perl = TRUE))[[1]]), collapse = " "))
  ph }
v30_fill <- function(x){
  if(!is.character(x)) return(x)
  keys <- unique(unlist(regmatches(x, gregexpr("\\{\\{[A-Z0-9_]+\\}\\}", x))))
  for(k in keys){
    nm <- gsub("[{}]", "", k); v <- V30_PH[[nm]]
    if(is.null(v) || is.na(v)){ V30_UNFILLED <<- union(V30_UNFILLED, nm); v <- paste0("[UNFILLED:", nm, "]") }
    x <- gsub(k, v, x, fixed = TRUE) }
  x }
v30_fill_df <- function(d){ d[] <- lapply(d, v30_fill); d }

