  k <- rownames(m)[m$Location == site]; s <- prune_samples(k, ps); s <- prune_taxa(taxa_sums(s) > 0, s)
  ms <- meta(s); d <- phyloseq::distance(s, dist); e <- exact_test(d, ms[labels(d), "SampleType"])
  set.seed(123); a <- adonis2(d ~ SampleType, data = ms[labels(d), , drop = FALSE], permutations = 999)
  if (abs(a[1, "R2"] - e[["R2"]]) > 1e-10) stop("exact-test R2 differs from adonis2 at ", site)
  n <- length(k); msr <- (1 - e[["R2"]]) / (n - 2)
  data.frame(level = level, site = site, distance = ifelse(dist == "bray", "Bray-Curtis", "weighted UniFrac"), n = n,
             n_natural_log = sum(ms$SampleType == "Natural Log"), R2 = e[["R2"]], chance_R2 = 1 / (n - 1),
             omega2 = om(e[["R2"]], 1, msr), F = e[["F"]], p_exact = e[["p_exact"]], assignments = e[["assignments"]],
             smallest_p = e[["smallest_p"]], p_999_permutations = a[1, "Pr(>F)"]) }
