save_fig <- function(name, plot, w=8, h=5){
  plot <- plot + labs(title = NULL, subtitle = NULL)
  fname <- file.path(FIG, paste0(name, ".png"))
  if (inherits(plot, "ggplot") && !inherits(plot, "patchwork")) {
    g <- ggplot2::ggplotGrob(plot)
    png(fname, width=w, height=h, units="in", res=FIG_DPI, bg="white")
    grid::grid.newpage(); grid::grid.draw(g); dev.off()
    od <- file.path(FIG, "objects"); dir.create(od, showWarnings = FALSE, recursive = TRUE)
    saveRDS(g, file.path(od, paste0(name, ".rds")))
  } else {
    ggsave(fname, plot, width=w, height=h, dpi=FIG_DPI, bg="white")
  } }

