assoc_tab <- function(b, f, keep, lab) {
  bp <- prune_samples(keep, b); fpz <- prune_samples(keep, f)
  db <- phyloseq::distance(bp, "bray"); df <- phyloseq::distance(fpz, "bray")
  df <- as.dist(as.matrix(df)[labels(db), labels(db)])
  md <- meta(bp)[labels(db), ]
  site_diff <- as.dist(1 * outer(as.character(md$Location), as.character(md$Location), "!="))
  batch_diff <- as.dist(1 * outer(as.character(md$Batch), as.character(md$Batch), "!="))
  set.seed(1); m0 <- mantel(db, df, permutations = 999)
  set.seed(1); mw <- mantel(db, df, permutations = how(blocks = factor(md$Location), nperm = 999))
  set.seed(1); ms <- mantel.partial(db, df, site_diff, permutations = 999)
  set.seed(1); mbt <- mantel.partial(db, df, batch_diff, permutations = 999)
  w <- as.vector(site_diff) == 0
  list(tab = data.frame(set = lab,
    test = c("Mantel, permutations within sites", "Mantel, unrestricted permutations",
             "partial Mantel, conditioning on site membership (unrestricted permutations)",
             "partial Mantel, conditioning on batch membership (unrestricted permutations; sites nested in batches)",
             "Pearson r, pairs from the same site", "Pearson r, pairs from different sites"),
    r = c(mw$statistic, m0$statistic, ms$statistic, mbt$statistic, cor(as.vector(db)[w], as.vector(df)[w]),
          cor(as.vector(db)[!w], as.vector(df)[!w])),
