SPIEC_NLAMBDA          <- 20
SPIEC_LAMBDA_MIN_RATIO <- 1e-2
EDGE_TOL               <- 1e-10
net_selection          <- NULL
note_selection <- function(se, section, network, substrate, n_samples, n_nodes) {
  b   <- as.matrix(symBeta(getOptBeta(se)))
  b   <- b[upper.tri(b)]
  idx <- tryCatch(as.integer(getOptInd(se))[1], error = function(e) NA_integer_)
  row <- data.frame(
    Section = section, Network = network, Substrate = substrate,
    Samples = n_samples, Nodes_offered = n_nodes,
    nlambda = SPIEC_NLAMBDA, Lambda_min_ratio = SPIEC_LAMBDA_MIN_RATIO,
    StARS_selected_index  = idx,
    StARS_stability       = tryCatch(as.numeric(getStability(se))[1], error = function(e) NA_real_),
    Edges                 = sum(abs(b) > EDGE_TOL),
    Entries_below_tolerance = sum(b != 0 & abs(b) <= EDGE_TOL),
    Empty_graph_selected  = isTRUE(idx == 1L),
    stringsAsFactors = FALSE)
  net_selection <<- rbind(net_selection, row)
  if (row$Empty_graph_selected)
    cat(sprintf("[NOTE] %s, %s, %s: StARS selected the first lambda of the path, i.e. the empty graph. No stable edge on this lambda path (nlambda = %d, lambda.min.ratio = %g).\n",
                section, network, substrate, SPIEC_NLAMBDA, SPIEC_LAMBDA_MIN_RATIO))
  invisible(row)
}

build_intra_spiec <- function(ps_sync, kingdom, wood_type, top_n = 50) {

  ps_sub  <- prune_samples(sample_names(ps_sync)[sample_data(ps_sync)$SampleType == wood_type], ps_sync)
  ps_gen  <- tax_glom(ps_sub, taxrank = "Genus", NArm = TRUE)
  ps_top  <- prune_taxa(names(sort(taxa_sums(ps_gen), decreasing = TRUE)[1:top_n]), ps_gen)
  mat     <- as.matrix(t(otu_table(ps_top)))

  set.seed(123)
  se_res <- spiec.easi(mat, method = "mb", nlambda = SPIEC_NLAMBDA, lambda.min.ratio = SPIEC_LAMBDA_MIN_RATIO,
                       pulsar.params = list(rep.num = 50, ncores = 1))
  se_adj <- as.matrix(symBeta(getOptBeta(se_res)))
  note_selection(se_res, "12A", paste(kingdom, "genera"), wood_type, nrow(mat), ncol(mat))
  tn     <- as.data.frame(tax_table(ps_top))
  cn     <- ifelse(is.na(tn$Genus), rownames(tn), tn$Genus)
  if (anyDuplicated(cn))
    stop("[12A] ", kingdom, " / ", wood_type, ": genus name used by more than one network node: ",
         paste(unique(cn[duplicated(cn)]), collapse = ", "), call. = FALSE)
  rownames(se_adj) <- cn; colnames(se_adj) <- cn
  se_adj[lower.tri(se_adj, diag = TRUE)] <- 0

  edges <- as.data.frame(as.table(se_adj), stringsAsFactors = FALSE) %>%
    setNames(c("from","to","raw_weight")) %>%
    filter(abs(raw_weight) > EDGE_TOL) %>%
    mutate(from = as.character(from), to = as.character(to),
           Interaction = ifelse(raw_weight > 0, "Co-occurrence", "Mutual Exclusion"),
           edge_width  = abs(raw_weight) * 10)

  save_csv(edges, "12a", paste0("IntraKingdom_Edges_", kingdom, "_", gsub(" ", "", wood_type)))

  if (nrow(edges) == 0)
    return(ggplot() + theme_void() +
             annotate("text", x = 0, y = 0, label = "No stable edge", size = 5, colour = "grey30"))

  graph_obj <- tbl_graph(nodes = data.frame(name = unique(c(edges$from, edges$to))),
                         edges = edges, directed = FALSE) %>%
    activate(nodes) %>% mutate(degree = centrality_degree())

  nc <- ifelse(kingdom == "Bacteria", "#FFD166", "#118AB2")
  ns <- ifelse(kingdom == "Bacteria", 21L, 22L)

  ggraph(graph_obj, layout = "fr") +
    geom_edge_link(aes(color = Interaction, width = edge_width), alpha = 0.7) +
    scale_edge_color_manual(values = c("Co-occurrence" = "#2EC4B6", "Mutual Exclusion" = "#E63946")) +
    scale_edge_width(range = c(0.5, 2.5), guide = "none") +
    geom_node_point(shape = ns, fill = nc, aes(size = degree), color = "black", stroke = 1) +
    geom_node_text(aes(label = gsub("_", " ", name), size = I(3 + degree * 0.4)),
                   repel = TRUE, fontface = "bold",
                   bg.color = "white", bg.r = 0.15, max.overlaps = Inf) +
    scale_size(range = c(3,14), guide = "none") +
    theme_graph() +
    labs(title    = paste(kingdom, "Intra-Kingdom:", wood_type),
         subtitle = paste("SPIEC-EASI |",
                          igraph::gorder(as.igraph(graph_obj)), "Nodes |",
                          nrow(edges), "Edges")) +
    theme(legend.position = "none", plot.title = element_text(size = 14, face = "bold"))
}

