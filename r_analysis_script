coassembly_prov <- local({
  brm <- coverm_mat(COVERM_BREADTH, mag4$bin[mag4$tier %in% c("HQ","MQ")])
  if(is.null(brm)) return(NULL)
  sc  <- intersect(colnames(brm), COHORT$id)
  if(!length(sc)) return(NULL)
  brm <- brm[, sc, drop = FALSE]
  meta <- COHORT[match(sc, COHORT$id), ]
  purrr::map_dfr(rownames(brm), function(b){
    v <- as.numeric(brm[b, ]); hit <- sc[v >= BREADTH_MIN]
    m  <- meta[meta$id %in% hit, , drop = FALSE]
    tibble(bin = b,
           n_samples_detected = length(hit),
           samples            = paste(hit, collapse = ";"),
           sites              = paste(unique(as.character(m$site)), collapse = ";"),
           substrates         = paste(unique(as.character(m$substrate)), collapse = ";"),
           spans_sites        = dplyr::n_distinct(m$site) > 1,
           spans_substrates   = dplyr::n_distinct(m$substrate) > 1,
           max_breadth        = round(max(v), 3),
           mean_breadth_where_detected = if(length(hit)) round(mean(v[v >= BREADTH_MIN]), 3) else NA_real_,
           partial_breadth_libraries   = sum(v > 0.1 & v < BREADTH_MIN),
           composite_flag = dplyr::n_distinct(m$site) > 1 | dplyr::n_distinct(m$substrate) > 1 |
                            length(hit) > 2) }) %>%
    left_join(mag4 %>% select(bin, phylum, genus, completeness, contamination), by = "bin") %>%
    arrange(dplyr::desc(n_samples_detected), bin) })

if(!is.null(coassembly_prov)){
  write.csv(coassembly_prov, file.path(TAB,"M4_coassembly_provenance.csv"), row.names = FALSE)
  .flag <- coassembly_prov %>% filter(composite_flag)
  .tab  <- table(coassembly_prov$n_samples_detected)
  cat("[mod4c] co-assembly control | genomes detected at >=", round(100*BREADTH_MIN),
      "% breadth in n libraries: ",
      paste(sprintf("%s:%d", names(.tab), as.integer(.tab)), collapse=" | "), "\n", sep="")
  cat("[mod4c] spanning >1 SITE: ", sum(coassembly_prov$spans_sites),
      " | >1 SUBSTRATE: ", sum(coassembly_prov$spans_substrates),
      " | composite-flagged: ", nrow(.flag),
      if(nrow(.flag)) paste0(" -> ", paste(.flag$bin, collapse=", ")) else "", "\n", sep="")
  if(nrow(.flag))
    cat("[mod4c] inspect the flagged genome(s) before quoting any per-genome result for them.",
        " A genome with partial breadth across many libraries is the signature of either a",
        " cross-sample composite or a reagent contaminant.\n", sep="")

  .expand <- function(df) df %>% tidyr::separate_rows(samples, sep=";") %>% filter(nzchar(samples))
  yield <- .expand(coassembly_prov %>% filter(!bin %in% CONTAMINANT_BINS)) %>%
    count(id = samples, name = "genomes_retained") %>%
    full_join(.expand(coassembly_prov) %>% count(id = samples, name = "genomes_incl_contaminant"),
              by = "id") %>%
    right_join(COHORT %>% select(id, substrate, site, library), by = "id") %>%
    mutate(across(c(genomes_retained, genomes_incl_contaminant), ~replace_na(.x, 0L))) %>%
    arrange(dplyr::desc(genomes_retained))
  write.csv(yield, file.path(TAB,"M4_genome_yield_per_sample.csv"), row.names = FALSE)

  if(exists("seq_prov") && exists("recruit") && !is.null(recruit)){
    dep <- yield %>% left_join(seq_prov %>% select(id, raw_read_pairs, raw_Gbp, raw_GC_pct), by="id") %>%
      left_join(recruit %>% transmute(id, recruited_pct = pct_to_kept_MAGs), by="id")
    sp <- function(a,b) suppressWarnings(cor(a, b, method="spearman", use="complete.obs"))
    depth_tbl <- tibble(
      comparison = c("raw depth vs genomes recovered","raw depth vs read recruitment",
                     "library GC vs genomes recovered","library GC vs read recruitment"),
      spearman_rho = round(c(sp(dep$raw_read_pairs, dep$genomes_retained),
                             sp(dep$raw_read_pairs, dep$recruited_pct),
                             sp(dep$raw_GC_pct,     dep$genomes_retained),
                             sp(dep$raw_GC_pct,     dep$recruited_pct)), 2),
      n = nrow(dep),
      note = "descriptive only at n = 8; no test is reported because none has power. The extremes are the argument: the 4th-deepest library yields no genome, the shallowest yields six.")
    write.csv(depth_tbl, file.path(TAB,"M4_depth_independence.csv"), row.names = FALSE)
    write.csv(dep, file.path(TAB,"M4_yield_vs_depth.csv"), row.names = FALSE)
    cat("[mod4c] depth independence: rho(depth, genomes) = ", depth_tbl$spearman_rho[1],
        " | rho(depth, recruitment) = ", depth_tbl$spearman_rho[2],
        " -- genome recovery is not depth-limited in this cohort\n", sep="") }
  cat("[mod4c] retained genomes per library: ",
      paste(sprintf("%s=%d", yield$id, yield$genomes_retained), collapse=", "), "\n", sep="")

  brm2 <- coverm_mat(COVERM_BREADTH, coassembly_prov$bin)
  if(!is.null(brm2)){
    sc2 <- intersect(COHORT$id, colnames(brm2))
    bin_ord <- coassembly_prov %>%
      mutate(first_hit = match(sub(";.*","",samples), sc2)) %>%
      arrange(is.na(first_hit), first_hit, dplyr::desc(max_breadth)) %>% pull(bin)
    hm <- as.data.frame(as.table(brm2[bin_ord, sc2, drop = FALSE]))
    names(hm) <- c("bin","id","breadth")
    hm <- hm %>% left_join(COHORT %>% select(id, substrate), by = "id") %>%
      mutate(bin = factor(as.character(bin), levels = rev(bin_ord)),
             id  = factor(as.character(id), levels = sc2),
             detected = breadth >= BREADTH_MIN)
    save_fig("F4e_coassembly_provenance",
      ggplot(hm, aes(id, bin, fill = breadth)) +
        geom_tile(colour = "white", linewidth = .3) +
        geom_point(data = subset(hm, detected), shape = 21, size = 1.1,
                   fill = "white", colour = "grey20", stroke = .3) +
        scale_fill_viridis_c(option = "mako", direction = -1, limits = c(0,1),
                             name = "Breadth of\ncoverage") +
        facet_grid(~substrate, scales = "free_x", space = "free_x") +
        labs(x = NULL, y = NULL) +
        theme(axis.text.y = element_text(size = 6),
              axis.text.x = element_text(angle = 45, hjust = 1),
              panel.grid = element_blank()), w = 8.2, h = 8)
    cap("F4e", paste0(
      "Breadth of coverage of every retained genome in every library -- the co-assembly control. ",
      "These genomes derive from one MEGAHIT co-assembly of eight libraries spanning three substrates and three sites, so a genome could in principle be a composite of populations from different samples rather than a single population. It is not: ",
      sum(coassembly_prov$n_samples_detected <= 1), " of ", nrow(coassembly_prov),
      " genomes are detected at >=", round(100*BREADTH_MIN), "% breadth in exactly one library, ",
      sum(coassembly_prov$spans_sites), " span more than one site and ",
      sum(coassembly_prov$spans_substrates), " span more than one substrate. ",
      "The matrix is block-diagonal by library. Two things follow. The per-genome results in later sections therefore describe single populations rather than cohort consensus sequences; and at genome resolution essentially no population is shared between sites or substrates, which is the conclusion Chapter 2 reached from geography-dominated beta diversity, here observed at a resolution amplicon cannot reach. ",
      "White dots mark detection at the ", round(100*BREADTH_MIN), "% breadth threshold. Genome yield is strongly uneven across libraries (M4_genome_yield_per_sample.csv), and that unevenness is what sets the mean read recruitment in F4d."))
  }
}

