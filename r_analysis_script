      theme_pub() +
      labs(x = .ax_labs[1], y = .ax_labs[2], colour = "Site", shape = "Substrate",
           title    = paste(kingdom_name, m_name, "(Location)"),
           subtitle = paste0("Marginal PERMANOVA: R\u00b2=", round(r2_l,3), ", p=", p_l))

    kg <- tolower(str_extract(kingdom_name, "^[A-Za-z]+"))
    print(p_t_plot); save_gg(p_t_plot, "8", paste0(kg, "_", m_name, "_SampleType"))
    print(p_l_plot); save_gg(p_l_plot, "8", paste0(kg, "_", m_name, "_Location"))

