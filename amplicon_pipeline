#!/usr/bin/env python3

01_trim_batch2_to_V4_and_merge.py

import csv, hashlib, os, sys
from collections import OrderedDict, defaultdict

SRC, OUT = sys.argv[1], sys.argv[2]
os.makedirs(OUT, exist_ok=True)
P515 = "GTGCCAGCMGCCGCGGTAA"
IUPAC = {"A": "A", "C": "C", "G": "G", "T": "T", "R": "AG", "Y": "CT", "S": "CG", "W": "AT", "K": "GT",
         "M": "AC", "B": "CGT", "D": "AGT", "H": "ACT", "V": "ACG", "N": "ACGT"}
MAXMM = 2
report = []
def say(*a):
    line = " ".join(str(x) for x in a); print(line); report.append(line)

def read_fasta(path):
    seqs, name, buf = OrderedDict(), None, []
    for line in open(path):
        line = line.rstrip("\n\r")
        if line.startswith(">"):
            if name is not None: seqs[name] = "".join(buf)
            name, buf = line[1:].split()[0], []
        elif line:
            buf.append(line.strip())
    if name is not None: seqs[name] = "".join(buf)
    return seqs

def read_batch(i):
    seqs = read_fasta(os.path.join(SRC, f"B{i}_Bact_feature.txt"))
    with open(os.path.join(SRC, f"B{i}_Bact_featureTable.sample.total.absolute.txt")) as fh:
        r = csv.reader(fh, delimiter="\t"); hdr = next(r)
        assert hdr[0] == "#OTU_num" and hdr[-1] == "Taxonomy"
        samples = hdr[1:-1]; rows = []
        for row in r:
            if row:
                rows.append((row[0], seqs[row[0]].upper(), row[-1], [float(x) for x in row[1:-1]]))
    assert len(rows) == len(seqs) and len({x[1] for x in rows}) == len(rows)
    return samples, rows

def merge(batches, tax_priority=None):
    """Outer join on exact sequence, rows in first-appearance order. Taxonomy: first batch in which the
    sequence appears, or, if tax_priority is given, the first batch in that order."""
    all_samples = [s for _, samples, _ in batches for s in samples]
    assert len(all_samples) == len(set(all_samples))
    col = {s: i for i, s in enumerate(all_samples)}
    table, taxby = OrderedDict(), defaultdict(dict)
    for b, samples, rows in batches:
        for asv, seq, tax, counts in rows:
            if seq not in table:
                table[seq] = [0.0] * len(all_samples)
            taxby[seq].setdefault(b, tax)
            for s, c in zip(samples, counts):
                table[seq][col[s]] += c
    order = tax_priority or [b for b, _, _ in batches]
    out = OrderedDict()
    for seq, counts in table.items():
        first = next(b for b in (tax_priority or [b for b, _, _ in batches]) if b in taxby[seq]) \
            if tax_priority else next(iter(taxby[seq]))
        out[seq] = (taxby[seq][first], counts, first)
    return all_samples, out

def write_table(path, samples, table):
    with open(path, "w", newline="") as f:
        f.write("\t".join(["Sequence", "Taxonomy"] + samples) + "\n")
        for seq, (tax, counts, _) in table.items():
            assert all(c == int(c) for c in counts)
            f.write("\t".join([seq, tax] + [str(int(c)) for c in counts]) + "\n")

def md5(path):
    h = hashlib.md5()
    with open(path, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""): h.update(b)
    return h.hexdigest()

def find_515f(seq):
    best = None
    L = len(P515)
    for i in range(0, len(seq) - L + 1):
        mm = 0
        for a, p in zip(seq[i:i + L], P515):
            if a not in IUPAC[p]:
                mm += 1
                if mm > MAXMM: break
        if mm <= MAXMM and (best is None or mm < best[1]):
            best = (i, mm)
            if mm == 0: break
    return best

say("# Batch-2 V3-V4 -> V4 trim and B1-B7 merge")
batches = [(f"B{i}",) + read_batch(i) for i in range(1, 8)]
for b, s, r in batches:
    say(f"{b}: {len(s)} samples, {len(r)} ASVs")

samples, tab0 = merge(batches)

b2_samples, b2_rows = batches[1][1], batches[1][2]
other_seqs = {seq for b, _, rows in batches if b != "B2" for _, seq, _, _ in rows}
log, kept, dropped = [], [], []
for asv, seq, tax, counts in b2_rows:
    hit = find_515f(seq)
    tot = sum(counts)
    if hit is None:
        dropped.append((asv, seq, tax, tot))
        log.append([asv, len(seq), "", "", "", "dropped: no 515F site", int(tot), tax, ""])
        continue
    pos, mm = hit
    v4 = seq[pos + len(P515):]
    kept.append((asv, v4, tax, counts))
    log.append([asv, len(seq), pos + 1, mm, len(v4), "trimmed", int(tot), tax, "yes" if v4 in other_seqs else "no"])

coll = OrderedDict()
for asv, v4, tax, counts in kept:
    if v4 not in coll:
        coll[v4] = [asv, tax, list(counts), sum(counts)]
    else:
        rec = coll[v4]
        rec[2] = [a + b for a, b in zip(rec[2], counts)]
        if sum(counts) > rec[3]:
            rec[0], rec[1], rec[3] = asv, tax, sum(counts)
b2_trim_rows = [(v[0], seq, v[1], v[2]) for seq, v in coll.items()]
tot_b2 = sum(sum(c) for _, _, _, c in b2_rows)
tot_drop = sum(d[3] for d in dropped)
say(f"Batch-2 ASVs: {len(b2_rows)}; trimmed: {len(kept)}; dropped (no 515F within {MAXMM} mismatches): {len(dropped)} "
    f"({tot_drop:.0f} of {tot_b2:.0f} batch-2 reads, {100 * tot_drop / tot_b2:.4f}%)")
mmc = defaultdict(int)
for r in log:
    if r[5] == "trimmed": mmc[r[3]] += 1
say("515F mismatches among trimmed ASVs: " + ", ".join(f"{k}: {v}" for k, v in sorted(mmc.items())))
lens = sorted(len(s) for s in coll)
say(f"Trimmed batch-2 sequences after collapsing identical ones: {len(coll)} (from {len(kept)}); "
    f"length min/median/max {lens[0]}/{lens[len(lens) // 2]}/{lens[-1]} bp")
shared = [s for s in coll if s in other_seqs]
say(f"Trimmed batch-2 sequences identical to an ASV from another batch: {len(shared)}; "
    f"they carry {100 * sum(sum(coll[s][2]) for s in shared) / (tot_b2 - tot_drop):.1f}% of the kept batch-2 reads")

batches_t = [batches[0], ("B2", b2_samples, b2_trim_rows)] + batches[2:]
samples_t, tab = merge(batches_t, tax_priority=["B1", "B3", "B4", "B5", "B6", "B7", "B2"])
out_tab = os.path.join(OUT, "Merged_B1_to_B7_Sequence_Absolute_V4trim.txt")
write_table(out_tab, samples_t, tab)
say(f"Merged V4trim table: {len(tab)} sequences x {len(samples_t)} samples (untrimmed merge: {len(tab0)} x {len(samples)})")

assert samples_t == samples
col = {s: i for i, s in enumerate(samples)}
for s in samples:
    before = sum(v[1][col[s]] for v in tab0.values()); after = sum(v[1][col[s]] for v in tab.values())
    if s in b2_samples:
        lost = sum(d_counts for d_counts in (next(r[3] for r in b2_rows if r[0] == d[0])[b2_samples.index(s)] for d in dropped))
        assert abs(before - lost - after) < 1e-6, s
    else:
        assert before == after, s
say("Check: every non-batch-2 sample keeps exactly its read total; every batch-2 sample loses only the reads of dropped ASVs.")
for b, smp, rows in batches:
    if b == "B2": continue
    for asv, seq, tax, counts in rows:
        for s, c in zip(smp, counts):
            assert tab[seq][1][col[s]] == c
say("Check: every count from batches 1 and 3-7 is unchanged, ASV by ASV.")
nb2_long = sum(1 for seq, v in tab.items() if len(seq) > 300 and any(v[1][col[s]] > 0 for s in b2_samples))
say(f"Check: batch-2 sequences longer than 300 bp left in the table: {nb2_long}")
assert nb2_long == 0
src_b = defaultdict(int)
for seq, (tax, counts, first) in tab.items():
    src_b[first] += 1
say("Taxonomy source (batch whose label is used): " + ", ".join(f"{k}: {v}" for k, v in sorted(src_b.items())))
gen = lambda t: next((x for x in t.split(";") if x.startswith("g__")), "g__(none)")
agree = dis = 0
for asv, v4, tax, counts in kept:
    if v4 in other_seqs:
        if gen(tax) == gen(tab[v4][0]): agree += sum(counts)
        else: dis += sum(counts)
say(f"Genus label of batch-2 ASV vs the label the merged table carries for its V4 sequence (shared sequences, read-weighted): "
    f"{100 * agree / (agree + dis):.1f}% agree")

with open(os.path.join(OUT, "B2_trim_log.tsv"), "w", newline="") as f:
    w = csv.writer(f, delimiter="\t")
    w.writerow(["B2_ASV", "length_V3V4", "515F_start_1based", "515F_mismatches", "length_V4", "fate",
                "B2_reads_total", "B2_taxonomy", "V4_sequence_also_in_other_batches"])
    w.writerows(log)
with open(os.path.join(OUT, "B2_dropped_no515F.fasta"), "w") as f:
    for asv, seq, tax, tot in dropped:
        f.write(f">{asv} reads={int(tot)} {tax}\n{seq}\n")
say(f"Output md5: {md5(out_tab)}  Merged_B1_to_B7_Sequence_Absolute_V4trim.txt")
open(os.path.join(OUT, "trim_and_merge_report.txt"), "w").write("\n".join(report) + "\n")

#!/usr/bin/env python3

02_make_picrust2_input.py

import csv, hashlib, os, sys

V4T, OUT = sys.argv[1], sys.argv[2]
os.makedirs(os.path.join(OUT, "picrust2"), exist_ok=True)
log = []
def say(*a):
    s = " ".join(str(x) for x in a); print(s); log.append(s)

def md5(p):
    h = hashlib.md5()
    with open(p, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""): h.update(b)
    return h.hexdigest()

def read_table(path):
    with open(path) as fh:
        r = csv.reader(fh, delimiter="\t"); hdr = next(r)
        assert hdr[:2] == ["Sequence", "Taxonomy"]
        return hdr, [row for row in r if row]

hdr, rows = read_table(V4T)

def picrust_files(header, rows, fasta, tsv):
    with open(fasta, "w") as f_out, open(tsv, "w") as t_out:
        w = csv.writer(t_out, delimiter="\t")
        w.writerow(["#OTU_ID"] + header[2:])
        for i, row in enumerate(rows, 1):
            f_out.write(f">ASV_{i}\n{row[0]}\n")
            w.writerow([f"ASV_{i}"] + row[2:])

picrust_files(hdr, rows, os.path.join(OUT, "picrust2", "study_seqs_V4trim.fasta"),
              os.path.join(OUT, "picrust2", "feature_table_V4trim.tsv"))
say(f"PICRUSt2 V4trim input: {len(rows)} ASVs x {len(hdr) - 2} samples")
for fn in ("study_seqs_V4trim.fasta", "feature_table_V4trim.tsv"):
    say(f"md5 {md5(os.path.join(OUT, 'picrust2', fn))}  picrust2/{fn}")
open(os.path.join(OUT, "picrust2", "input_manifest.txt"), "w").write("\n".join(log) + "\n")

#!/bin/bash

#PBS -N setup_V4trim
#PBS -P PROJECT_CODE
#PBS -q QUEUE_NAME
#PBS -l select=1:ncpus=4:mem=32gb
#PBS -l walltime=06:00:00
#PBS -o setup_V4trim.out
#PBS -e setup_V4trim.err
source ~/.bashrc
set -eo pipefail
ROOT="${ROOT:?set ROOT to the amplicon run directory on scratch}"
cd ${ROOT}
exec > >(tee ${ROOT}/setup_V4trim.log) 2>&1
REF=${ROOT}/reclassify/refdb
Q2ENV=rachis-qiime2-2026.7
Q2YML=https://raw.githubusercontent.com/qiime2/distributions/refs/heads/dev/2026.7/qiime2/released/rachis-qiime2-linux-64-conda.yml
Q2CH=https://packages.qiime2.org/qiime2/2026.7/qiime2/released
NODE_TMP="${TMPDIR:-/tmp}"
if [ "$(df -Pk "${NODE_TMP}" | awk 'NR == 2 {print int($4 / 1048576)}')" -ge 10 ]; then
  export TMPDIR="${NODE_TMP}/setup_V4trim.$$"
else
  export TMPDIR=${ROOT}/reclassify/tmp_setup
  echo "[setup] WARNING: less than 10 GB free in ${NODE_TMP}; temporary files go to /scratch instead"
fi
mkdir -p ${REF} ${TMPDIR}
echo "[setup] start $(date) on $(hostname); ROOT=${ROOT}; temporary files in ${TMPDIR}"

env_prefix() { conda env list | awk -v n="$1" '$1 == n {print $NF}'; }

if [ -z "$(env_prefix ${Q2ENV})" ]; then
  echo "[setup] creating ${Q2ENV} from the official 2026.7 package list"
  YML=${ROOT}/reclassify/rachis-qiime2-2026.7.yml
  SPECS=${ROOT}/reclassify/rachis-qiime2-2026.7_packages.txt
  curl -fsSL ${Q2YML} -o ${YML}
  CH=$(awk '/^channels:/{c=1; next} /^[^- ]/{c=0} c && /^- /{print substr($0, 3)}' ${YML} | paste -sd' ' -)
  if [ "${CH}" != "conda-forge bioconda ${Q2CH}" ]; then echo "[setup] STOP: unexpected channels: ${CH}"; exit 1; fi
  awk '/^dependencies:/{d=1; next} /^[^- ]/{d=0} d && /^- /{print substr($0, 3)}' ${YML} > ${SPECS}
  if [ "$(wc -l < ${SPECS})" -lt 500 ] || grep -qv '^[A-Za-z0-9_.-]*=[^= ]*$' ${SPECS}; then
    echo "[setup] STOP: could not read the package list from ${YML}"; exit 1
  fi
  conda create -y -n ${Q2ENV} --override-channels -c conda-forge -c bioconda -c ${Q2CH} --file ${SPECS}
fi
if [ -z "$(env_prefix phylo_v4trim)" ]; then
  echo "[setup] creating phylo_v4trim"
  conda create -y -n phylo_v4trim --override-channels -c conda-forge -c bioconda mafft=7.525 iqtree=3.0.1
fi
if [ -z "$(env_prefix picrust2_251)" ]; then
  echo "[setup] creating picrust2_251"
  conda create -y -n picrust2_251 --override-channels -c conda-forge -c bioconda picrust2=2.5.1
fi

conda activate phylo_v4trim
echo "[setup] MAFFT:    $(mafft --version 2>&1 | head -1)"
IQ=$(command -v iqtree3 || command -v iqtree2 || command -v iqtree)
echo "[setup] IQ-TREE:  $(${IQ} --version 2>&1 | grep -m1 -i 'IQ-TREE')"
conda deactivate
conda activate picrust2_251
echo "[setup] PICRUSt2: $(picrust2_pipeline.py --version 2>&1 | head -1)"
conda deactivate
conda activate ${Q2ENV}
qiime info > ${ROOT}/reclassify/qiime_info.txt 2>&1
grep -iE '(release|version)[^:]*:' ${ROOT}/reclassify/qiime_info.txt | head -3 | sed 's/^/[setup] /' || true
echo "[setup] $(grep -m1 -i 'rescript' ${ROOT}/reclassify/qiime_info.txt | sed 's/^ *//')"
echo "[setup] $(grep -m1 -i 'feature-classifier' ${ROOT}/reclassify/qiime_info.txt | sed 's/^ *//')"
echo "[setup] scikit-learn: $(python -c 'import sklearn; print(sklearn.__version__)')"

cd ${REF}
S=silva-138.2-ssu-nr99
if [ -s ${S}-rna-seqs.qza ] && [ -s ${S}-tax.qza ]; then
  echo "[setup] SILVA 138.2 already downloaded"
else
  echo "[setup] downloading SILVA 138.2 SSURef NR99 $(date)"
  qiime rescript get-silva-data \
    --p-version 138.2 \
    --p-target SSURef_NR99 \
    --p-no-include-species-labels \
    --p-rank-propagation \
    --o-silva-sequences ${S}-rna-seqs.partial.qza \
    --o-silva-taxonomy ${S}-tax.partial.qza
  qiime tools validate ${S}-rna-seqs.partial.qza
  qiime tools validate ${S}-tax.partial.qza
  mv ${S}-rna-seqs.partial.qza ${S}-rna-seqs.qza
  mv ${S}-tax.partial.qza ${S}-tax.qza
fi
U=unite-10.0-2025-02-19-euk-99
if [ -s ${U}-seqs.qza ] && [ -s ${U}-tax.qza ]; then
  echo "[setup] UNITE 10.0 already downloaded"
else
  echo "[setup] downloading UNITE 10.0 (2025-02-19, all eukaryotes, 99%) $(date)"
  qiime rescript get-unite-data \
    --p-version 2025-02-19 \
    --p-taxon-group eukaryotes \
    --p-cluster-id 99 \
    --p-no-singletons \
    --o-sequences ${U}-seqs.partial.qza \
    --o-taxonomy ${U}-tax.partial.qza
  qiime tools validate ${U}-seqs.partial.qza
  qiime tools validate ${U}-tax.partial.qza
  mv ${U}-seqs.partial.qza ${U}-seqs.qza
  mv ${U}-tax.partial.qza ${U}-tax.qza
fi
ls -l ${REF}
rm -rf ${TMPDIR}
echo "[setup DONE] $(date). Next: 04_reclassify.sh"

#!/bin/bash
#PBS -N reclassify_V4trim
#PBS -P PROJECT_CODE
#PBS -q QUEUE_NAME
#PBS -l select=1:ncpus=40:mem=128gb
#PBS -l walltime=24:00:00
#PBS -o reclassify_V4trim.out
#PBS -e reclassify_V4trim.err
source ~/.bashrc
set -eo pipefail
set +u; conda activate rachis-qiime2-2026.7; set -u
ROOT="${ROOT:?set ROOT to the amplicon run directory on scratch}"
RC=${ROOT}/reclassify
REF=${RC}/refdb
CLF=${RC}/classifiers
WK=${RC}/work
OUT=${RC}/output
NT=${NCPUS:-40}
NODE_TMP="${TMPDIR:-/tmp}"
if [ "$(df -Pk "${NODE_TMP}" | awk 'NR == 2 {print int($4 / 1048576)}')" -ge 30 ]; then
  export TMPDIR="${NODE_TMP}/reclassify_V4trim.$$"
else
  export TMPDIR=${RC}/tmp
  echo "[reclassify] WARNING: less than 30 GB free in ${NODE_TMP}; temporary files go to /scratch instead"
fi
export JOBLIB_TEMP_FOLDER=${TMPDIR}
mkdir -p ${CLF} ${WK} ${OUT} ${TMPDIR}
cd ${RC}
step() { echo "[reclassify] $(date '+%F %T')  $*"; }
nseq() {   # number of sequences inside a FeatureData[Sequence] or [RNASequence] .qza
  python3 - "$1" <<'PY'
import sys, zipfile
z = zipfile.ZipFile(sys.argv[1])
print(sum(sum(1 for l in z.open(n) if l.startswith(b">")) for n in z.namelist()
          if "/data/" in n and n.endswith(".fasta")))
PY
}

if [ -s ${OUT}/RECLASSIFY_DONE.txt ]; then
  step "already finished (${OUT}/RECLASSIFY_DONE.txt exists); nothing to do"; exit 0
fi
S=silva-138.2-ssu-nr99
U=unite-10.0-2025-02-19-euk-99
for f in ${S}-rna-seqs.qza ${S}-tax.qza ${U}-seqs.qza ${U}-tax.qza; do
  if [ ! -s ${REF}/${f} ]; then
    step "STOP: ${REF}/${f} is missing. Run 03_setup_envs_databases.sh first."; exit 1
  fi
done
step "$(qiime info 2>/dev/null | grep -iE '(release|version)[^:]*:' | grep -iv python | head -1); ${NT} CPUs; temporary files in ${TMPDIR}"

W=${WK}/${S}
if [ ! -s ${W}-seqs.qza ]; then
  step "SILVA: reverse-transcribe RNA to DNA"
  qiime rescript reverse-transcribe \
    --i-rna-sequences ${REF}/${S}-rna-seqs.qza \
    --o-dna-sequences ${W}-seqs.partial.qza
  mv ${W}-seqs.partial.qza ${W}-seqs.qza
fi
if [ ! -s ${W}-seqs-cleaned.qza ]; then
  step "SILVA: cull-seqs (5 or more ambiguous bases, or homopolymers of 8 or more)"
  qiime rescript cull-seqs \
    --i-sequences ${W}-seqs.qza \
    --p-n-jobs ${NT} \
    --o-clean-sequences ${W}-seqs-cleaned.partial.qza
  mv ${W}-seqs-cleaned.partial.qza ${W}-seqs-cleaned.qza
fi
if [ ! -s ${W}-seqs-filt.qza ]; then
  step "SILVA: length filter (Archaea >= 900, Bacteria >= 1200, Eukaryota >= 1400 bp)"
  qiime rescript filter-seqs-length-by-taxon \
    --i-sequences ${W}-seqs-cleaned.qza \
    --i-taxonomy ${REF}/${S}-tax.qza \
    --p-labels Archaea Bacteria Eukaryota \
    --p-min-lens 900 1200 1400 \
    --o-filtered-seqs ${W}-seqs-filt.partial.qza \
    --o-discarded-seqs ${W}-seqs-discard.partial.qza
  mv ${W}-seqs-discard.partial.qza ${W}-seqs-discard.qza
  mv ${W}-seqs-filt.partial.qza ${W}-seqs-filt.qza
fi
if [ ! -s ${W}-seqs-derep.qza ]; then
  step "SILVA: dereplicate (uniq)"
  qiime rescript dereplicate \
    --i-sequences ${W}-seqs-filt.qza \
    --i-taxa ${REF}/${S}-tax.qza \
    --p-mode uniq \
    --o-dereplicated-sequences ${W}-seqs-derep.partial.qza \
    --o-dereplicated-taxa ${W}-tax-derep.partial.qza
  mv ${W}-tax-derep.partial.qza ${W}-tax-derep.qza
  mv ${W}-seqs-derep.partial.qza ${W}-seqs-derep.qza
fi
if [ ! -s ${W}-515f-806r-seqs.qza ]; then
  step "SILVA: extract the 515F/806R region (this study's primers)"
  qiime feature-classifier extract-reads \
    --i-sequences ${W}-seqs-derep.qza \
    --p-f-primer GTGCCAGCMGCCGCGGTAA \
    --p-r-primer GGACTACHVGGGTWTCTAAT \
    --p-read-orientation forward \
    --p-n-jobs ${NT} \
    --o-reads ${W}-515f-806r-seqs.partial.qza \
    --o-read-extraction-stats ${W}-515f-806r-extraction-stats.partial.qza
  mv ${W}-515f-806r-extraction-stats.partial.qza ${W}-515f-806r-extraction-stats.qza
  mv ${W}-515f-806r-seqs.partial.qza ${W}-515f-806r-seqs.qza
fi
if [ ! -s ${W}-515f-806r-seqs-derep.qza ]; then
  step "SILVA: dereplicate the V4 region (uniq)"
  qiime rescript dereplicate \
    --i-sequences ${W}-515f-806r-seqs.qza \
    --i-taxa ${W}-tax-derep.qza \
    --p-mode uniq \
    --o-dereplicated-sequences ${W}-515f-806r-seqs-derep.partial.qza \
    --o-dereplicated-taxa ${W}-515f-806r-tax-derep.partial.qza
  mv ${W}-515f-806r-tax-derep.partial.qza ${W}-515f-806r-tax-derep.qza
  mv ${W}-515f-806r-seqs-derep.partial.qza ${W}-515f-806r-seqs-derep.qza
fi
if [ ! -s ${CLF}/${S}-515f-806r-classifier.qza ]; then
  step "SILVA: train the naive Bayes classifier (single thread, about 1-3 h)"
  qiime feature-classifier fit-classifier-naive-bayes \
    --i-reference-reads ${W}-515f-806r-seqs-derep.qza \
    --i-reference-taxonomy ${W}-515f-806r-tax-derep.qza \
    --o-classifier ${CLF}/${S}-515f-806r-classifier.partial.qza
  mv ${CLF}/${S}-515f-806r-classifier.partial.qza ${CLF}/${S}-515f-806r-classifier.qza
fi


if [ ! -s ${CLF}/${U}-classifier.qza ]; then
  step "UNITE: train the naive Bayes classifier (single thread, about 1-3 h)"
  qiime feature-classifier fit-classifier-naive-bayes \
    --i-reference-reads ${REF}/${U}-seqs.qza \
    --i-reference-taxonomy ${REF}/${U}-tax.qza \
