wrap_ko_desc <- function(desc, width) {
  vapply(desc, function(d) {
    if (is.na(d)) return(NA_character_)
    words <- strsplit(d, " ", fixed = TRUE)[[1]]
    if (!any(nchar(words) > 1.25 * width)) return(stringr::str_wrap(d, width = width))
    pieces <- character(0); glue <- logical(0)
    for (w in words) {
      p <- if (nchar(w) > 1.25 * width) regmatches(w, gregexpr("[^-]*-|[^-]+$", w))[[1]] else w
      pieces <- c(pieces, p); glue <- c(glue, FALSE, rep(TRUE, length(p) - 1))
    }
    lines <- character(0); cur <- ""
    for (i in seq_along(pieces)) {
      cand <- if (!nzchar(cur)) pieces[i] else paste0(cur, if (glue[i]) "" else " ", pieces[i])
      if (nzchar(cur) && nchar(cand) > width) { lines <- c(lines, cur); cur <- pieces[i] } else cur <- cand
    }
    paste(c(lines, cur), collapse = "\n")
  }, character(1), USE.NAMES = FALSE)
}

make_ko_label <- function(ko_ids, wrap_at = 28) {
  bare   <- sub("^ko:", "", ko_ids)
  desc   <- ko_desc_unique$ko_des[match(bare, ko_desc_unique$ko)]
  labels <- dplyr::if_else(
    is.na(desc),
    bare,
    paste0(bare, ":\n", wrap_ko_desc(desc, wrap_at))
  )
  stats::setNames(labels, ko_ids)
}

make_ko_label_flat <- function(ko_ids) {
  bare <- sub("^ko:", "", ko_ids)
  desc <- ko_desc_unique$ko_des[match(bare, ko_desc_unique$ko)]
  stats::setNames(dplyr::if_else(is.na(desc), bare, paste0(bare, ": ", desc)), ko_ids)
}

