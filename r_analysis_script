harmonise_phylum <- function(p) { p <- trimws(as.character(p))
  ifelse(p %in% names(PHYLUM_SYN), PHYLUM_SYN[p], p) }
pal_phylum <- function(levels) {
  orig <- unique(as.character(levels))
  h    <- harmonise_phylum(orig)
  col  <- unname(PHYLUM_FIXED[h]); na <- is.na(col)
  if (any(na)) col[na] <- vapply(h[na], function(nm)
    if (is.na(nm) || grepl("^Other", nm, ignore.case = TRUE)) "grey70"
    else .PHYFALLBACK[1 + (sum(utf8ToInt(nm)) %% length(.PHYFALLBACK))], character(1))
  setNames(col, orig)
}

pal_categorical <- function(levels, others_grey = TRUE) {
  levels <- as.character(levels)
  ramp   <- c(OKABE_ITO, "#999999", "#44AA99", "#882255", "#332288", "#117733")
  cols   <- setNames(grDevices::colorRampPalette(ramp)(length(levels)), levels)
  if (others_grey) {
    o <- grepl("^Other", levels, ignore.case = TRUE)
    if (any(o)) cols[levels[o]] <- "grey80"
  }
  cols
}

