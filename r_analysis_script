  build <- function(feat, renorm){
    A <- matrix(0, length(feat), length(S), dimnames = list(feat, S))
    B <- A
    A[intersect(feat, rownames(ampM)), S]  <- ampM[intersect(feat, rownames(ampM)), S]
    B[intersect(feat, rownames(shotM)), S] <- shotM[intersect(feat, rownames(shotM)), S]
    M <- cbind(A, B)
    if(renorm){ cs <- colSums(M)
      if(any(cs == 0)) stop("method_effect(", king, "): no shared features detected in sample(s) ",
                            paste(unique(colnames(M)[cs == 0]), collapse=", "),
                            "; Bray-Curtis is undefined for an all-zero profile")
      M <- sweep(M, 2, cs, "/") }
    M }

  ctrl_method <- permute::how(blocks = pair, within = permute::Within(type = "free"), nperm = 9999)
  ctrl_subst  <- permute::how(plots  = permute::Plots(strata = pair, type = "free"),
                              within = permute::Within(type = "none"), nperm = 9999)

  run <- function(M, tag){
    d <- vegdist(t(M), "bray")
    pm_m <- seeded(adonis2(d ~ method + substrate, data = meta, by = "margin", permutations = ctrl_method))
    pm_s <- seeded(adonis2(d ~ method + substrate, data = meta, by = "margin", permutations = ctrl_subst))
    tibble(feature_set = tag, n_features = nrow(M),
           method_R2    = round(pm_m$R2[1], 3), method_p    = pm_m$`Pr(>F)`[1],
           substrate_R2 = round(pm_s$R2[2], 3), substrate_p = pm_s$`Pr(>F)`[2]) }

  U  <- union(rownames(ampM), rownames(shotM)); SHc <- intersect(rownames(ampM), rownames(shotM))
  Mu <- build(U, renorm = FALSE); Ms <- build(SHc, renorm = TRUE)
  res <- bind_rows(run(Ms, "shared features only (PRIMARY)"),
                   run(Mu, "union of features (upper bound)")) %>% mutate(kingdom = king, .before = 1)

  pco <- cmdscale(vegdist(t(Ms), "bray"), k = 2)
  pd  <- tibble(PCo1 = pco[,1], PCo2 = pco[,2], method = meta$method, substrate = meta$substrate,
                lab = sprintf("%s\nmethod R\u00b2 = %.2f, p = %.4f\nsubstrate R\u00b2 = %.2f, p = %.3f",
                              sub(" \\(.*", "", king), res$method_R2[1], res$method_p[1],
                              res$substrate_R2[1], res$substrate_p[1]))
  wsh <- suppressWarnings(wilcox.test(vegan::diversity(t(ampM[,S])), vegan::diversity(t(shotM[,S])), paired = TRUE)$p.value)
  wri <- suppressWarnings(wilcox.test(colSums(ampM[,S] > 0), colSums(shotM[,S] > 0), paired = TRUE)$p.value)
  list(pd = pd, stat = res %>% mutate(alpha_shannon_wilcox_p = round(wsh,4),
                                      alpha_richness_wilcox_p = round(wri,4),
                                      method_p_floor = round(2/256, 4),
                                      note = "method tested by within-pair permutation; substrate by whole-pair permutation")) }
