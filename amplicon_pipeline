set -eo pipefail
set +u; conda activate phylo_v4trim; set -u
ROOT="${ROOT:?set ROOT to the amplicon run directory on scratch}"
exec > >(tee -a ${ROOT}/bact_tree_V4trim.log) 2>&1
echo "[bact_tree] start $(date) on $(hostname)"
MARK=${ROOT}/reclassify/output/RECLASSIFY_DONE.txt
if [ ! -s ${MARK} ]; then
  echo "[bact_tree] STOP: ${MARK} not found. 04_reclassify.sh has not finished; submit this job after it."
