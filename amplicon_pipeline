  echo "  515F/806R region after dereplication (training set):  $(nseq ${W}-515f-806r-seqs-derep.qza)"
  echo "UNITE 10.0 (2025-02-19) all eukaryotes 99% (training set): $(nseq ${REF}/${U}-seqs.qza)"
  qiime info 2>/dev/null | grep -iE '(release|version)[^:]*:' | head -3 || true
  echo "scikit-learn: $(python3 -c 'import sklearn; print(sklearn.__version__)')"
