pooled <- function(ps, m, dist, lab) {
  k <- rownames(m)[m$Location %in% c("BTNR", "LNR")]; s <- prune_samples(k, ps); s <- prune_taxa(taxa_sums(s) > 0, s)
  ms <- meta(s); d <- phyloseq::distance(s, dist); D2 <- as.matrix(d)^2; ms <- ms[labels(d), ]
  n <- nrow(ms); sst <- sum(D2) / (2 * n)
  ss_site_within <- sum(sapply(split(seq_len(n), ms$Location), function(i) sum(D2[i, i]) / (2 * length(i))))
  per <- lapply(c("BTNR", "LNR"), function(st) { i <- which(ms$Location == st); assign_ssw(D2[i, i], ms$SampleType[i]) })
  ssw_obs <- per[[1]]$obs[["ssw"]] + per[[2]]$obs[["ssw"]]
  all <- outer(per[[1]]$all, per[[2]]$all, "+")
  ss_sub <- ss_site_within - ssw_obs; ms_res <- ssw_obs / (n - 4)
  data.frame(level = lab, distance = ifelse(dist == "bray", "Bray-Curtis", "weighted UniFrac"), n = n, df = 2,
             R2_substrate_within_site = ss_sub / sst, omega2 = (ss_sub - 2 * ms_res) / (sst + ms_res), F = (ss_sub / 2) / ms_res,
             p_exact = mean(all <= ssw_obs * (1 + 1e-10)), assignments = length(all)) }
