shrink <- function(gr, s){
  if (!is.null(gr$gp)) {
    if (!is.null(gr$gp$fontsize)) gr$gp$fontsize <- gr$gp$fontsize * s
    if (!is.null(gr$gp$cex))      gr$gp$cex      <- gr$gp$cex      * s
    if (!is.null(gr$gp$lwd))      gr$gp$lwd      <- gr$gp$lwd      * s
  }
  if (inherits(gr, "textrepeltree") && !is.null(gr$data)) {
    if (!is.null(gr$data$size))         gr$data$size         <- gr$data$size * s
    if (!is.null(gr$data$segment.size)) gr$data$segment.size <- gr$data$segment.size * s
  }
  if (inherits(gr, "gtable")) gr$grobs <- lapply(gr$grobs, shrink, s = s)
  else if (inherits(gr, "gTree") && length(gr$children))
    gr$children <- do.call(gList, lapply(gr$children, shrink, s = s))
  gr
}
get_legend <- function(g){
  for (i in which(grepl("^guide-box", g$layout$name))) {
    gb <- g$grobs[[i]]
    if (!inherits(gb, "zeroGrob") && !inherits(gb, "null")) return(gb)
  }
  nullGrob()
}
drop_cells <- function(g, pattern, collapse = TRUE){
  hit <- grepl(pattern, g$layout$name)
  for (i in which(hit)) {
    lay    <- g$layout[i, ]
    others <- g$layout[-i, , drop = FALSE]
    col_shared <- any(others$l >= lay$l & others$r <= lay$r)
    row_shared <- any(others$t >= lay$t & others$b <= lay$b)
    if (collapse && lay$l == lay$r && !col_shared && !identical(grid::unitType(g$widths[lay$l]), "null"))
      g$widths[lay$l] <- unit(0, "mm")
    if (collapse && lay$t == lay$b && !row_shared && !identical(grid::unitType(g$heights[lay$t]), "null"))
      g$heights[lay$t] <- unit(0, "mm")
    g$grobs[[i]] <- nullGrob()
  }
  g
}
drop_legend <- function(g, collapse = TRUE) drop_cells(g, "^guide-box", collapse = collapse)

G <- function(spec){
  sp  <- strsplit(spec, ":", fixed = TRUE)[[1]]
  rds <- file.path(OBJ[[sp[1]]], paste0(sp[2], ".rds"))
  if (!file.exists(rds)) stop("Panel not found: ", spec, " (", rds, ")", call. = FALSE)
  readRDS(rds)
}
P <- function(spec, s = 0.85, legend = TRUE, strip_title = FALSE, keep_legend_space = FALSE){
  sp  <- strsplit(spec, ":", fixed = TRUE)[[1]]
  rds <- file.path(OBJ[[sp[1]]], paste0(sp[2], ".rds"))
  if (file.exists(rds)) {
    g <- readRDS(rds)
    if (inherits(g, "gtable")) {
      if (!legend)     g <- drop_legend(g, collapse = !keep_legend_space)
      if (strip_title) g <- drop_cells(g, "^main$")
    }
    if (s != 1) g <- shrink(g, s)
    return(wrap_elements(full = g))
  }
  f <- file.path(PNGDIR[[sp[1]]], paste0(sp[2], ".png"))
  if (file.exists(f)) {
    warning("Panel ", spec, ": grob .rds missing; using raster PNG fallback.", call. = FALSE)
    return(wrap_elements(full = rasterGrob(readPNG(f), interpolate = TRUE)))
  }
  stop("Panel not found: ", spec, "\n  looked for: ", rds,
       "\n  Run the owning pipeline first.", call. = FALSE)
}

emit <- function(name, patch, w_mm, h_mm, k, tag = TRUE){
  if (tag) patch <- patch + plot_annotation(tag_levels = "A") &
             theme(plot.tag = element_text(face = "bold", size = 11))
  ggsave(file.path(OUT, paste0(name, ".png")), patch,
         width = w_mm * k, height = h_mm * k, units = "mm",
         dpi = DPI_EFF / k, bg = "white", limitsize = FALSE)
  .emitted <<- c(.emitted, name)
  cat(sprintf("  %-10s print %3.0f x %3.0f mm @ %d dpi effective (emit %.0fx%.0f, text 1/%.2f)\n",
              name, w_mm, h_mm, DPI_EFF, w_mm * k, h_mm * k, k))
}

