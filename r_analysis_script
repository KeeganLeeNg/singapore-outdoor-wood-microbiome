           title    = paste(kingdom_name, m_name, "(SampleType)"),
           subtitle = paste0("Marginal PERMANOVA: R\u00b2=", round(r2_t,3), ", p=", p_t))

    p_l_plot <- plot_ordination(ps_rare, pcoa, color = "Location", shape = "SampleType") +
      geom_point(size = 4, alpha = 0.8) +
      stat_ellipse(aes(group = Location, color = Location),
