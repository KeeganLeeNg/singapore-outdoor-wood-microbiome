gc_check <- tryCatch({
  gcv <- setNames(q9$GC, q9$bin)
  if(all(is.na(gcv))) stop("no GC column")
  if(max(gcv, na.rm=TRUE) <= 1) gcv <- gcv*100
  stopifnot(!is.null(ab9))
  per_sample <- tibble(id = colnames(ab9),
                       gc_weighted_mean = apply(ab9, 2, function(v){
                         w <- v[!is.na(gcv[rownames(ab9)])]; g <- gcv[rownames(ab9)][!is.na(gcv[rownames(ab9)])]
                         if(sum(w) == 0) NA_real_ else sum(w*g)/sum(w) })) %>%
    left_join(COHORT %>% select(id, library, substrate), by = "id")
  wt <- suppressWarnings(tryCatch(
    wilcox.test(gc_weighted_mean ~ (library == "TruSeq Nano"), data = per_sample)$p.value,
    error = function(e) NA_real_))
  write.csv(per_sample, file.path(TAB,"M9_gc_bias_check.csv"), row.names = FALSE)
  fig_stat("F9c GC bias","TruSeq vs Nextera","Wilcoxon P (genome GC)", NA, if(is.na(wt)) "not testable" else signif(wt,3), NA, "Wilcoxon rank-sum","F9c")
  save_fig("F9c_gc_bias_check",
           ggplot(tibble(bin = names(gcv), GC = as.numeric(gcv)) %>% filter(!is.na(GC)),
                  aes(GC)) + geom_histogram(bins = 20, fill = "#4d9221", colour = "white") +
             geom_vline(xintercept = 70, linetype = 2, colour = "#b2182b") +
             labs(title = "GC content of the recovered genomes",
                  subtitle = sprintf("TruSeq vs Nextera, Wilcoxon P = %s",
                                     ifelse(is.na(wt), "not testable", sprintf("%.3f", wt))),
                  x = "genome GC (%)", y = "MAGs"), w = 8, h = 4.6)
  cap("F9c", paste0("GC content of the recovered genomes, with the abundance-weighted GC of the single TruSeq Nano library (M73) against the seven Nextera XT libraries (M9_gc_bias_check.csv). Nextera XT is tagmentation-based and depletes high-GC templates, so this panel asks whether high-GC genomes could be under-recovered for that reason. Three qualifications. The library assignment was inverted in all runs before v22 and this panel is the corrected version. n = 1 for TruSeq, so no test has power and the Wilcoxon is reported as a descriptive contrast only; M73 is also the sole MET-spruce/GAIA library, so chemistry is confounded with substrate and site. Finally, the raw library GC in M1_sequencing_provenance.csv runs 56.1-64.2% across the cohort and correlates POSITIVELY with read recruitment (M4_depth_independence.csv), which is the opposite of what a strong GC-driven assembly penalty would produce -- the two highest-GC libraries are the two highest recruiters. On the evidence available, GC depletion is not the explanation for non-recovery, but neither is it excluded."))
  per_sample
}, error = function(e){ message("[mod9] GC bias check skipped: ", conditionMessage(e)); NULL })

