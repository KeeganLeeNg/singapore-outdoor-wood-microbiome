  f <- bakta_tsv_path(b); if(is.na(f)) return(blank)
  bk <- tryCatch(read.delim(f, header = FALSE, comment.char = "#", quote = "",
                            stringsAsFactors = FALSE, fill = TRUE),
                 error = function(e) NULL)
  if(is.null(bk) || ncol(bk) < 9 || !nrow(bk)) return(blank)
  type <- tolower(trimws(as.character(bk[[2]])))
  prod <- trimws(as.character(bk[[8]]))
  trna <- prod[type == "trna"]
  aa <- toupper(sub("^tRNA-f?([A-Za-z]{3}).*$", "\\1", trna))
  aa <- aa[nchar(aa) == 3 & !aa %in% c("XXX","UND","OTH","SUP","SEC","PYL")]
  rrna <- prod[type == "rrna"]
  tibble(bin = b, n_tRNA = length(trna), n_tRNA_aa = n_distinct(aa),
         has_5S  = any(grepl("(^|[^0-9])5S",  rrna)),
         has_16S = any(grepl("16S", rrna)),
         has_23S = any(grepl("23S", rrna)),
         bakta_file = f) })

