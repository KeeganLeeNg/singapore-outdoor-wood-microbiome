cat("\n--- 7. Alpha Diversity ---\n")

run_alpha_stats <- function(ps_rare, kingdom_name, has_tree = FALSE) {

  alpha_df        <- estimate_richness(ps_rare, measures = c("Observed", "Shannon"))
  alpha_df$SampleID <- sample_names(ps_rare)
  otu_mat <- as(otu_table(ps_rare), "matrix")
  if (taxa_are_rows(ps_rare)) otu_mat <- t(otu_mat)
  bp_vals <- apply(otu_mat, 1, function(x) max(x) / sum(x))
  alpha_df <- merge(alpha_df,
                    data.frame(SampleID = names(bp_vals),
                               `Berger-Parker` = bp_vals, check.names = FALSE),
                    by = "SampleID")

  if (has_tree) {
    pd_df <- picante::pd(as.data.frame(t(otu_table(ps_rare))),
                         phy_tree(ps_rare), include.root = TRUE)
    pd_df$SampleID <- rownames(pd_df)
    alpha_df       <- merge(alpha_df, pd_df[, c("PD","SampleID")], by = "SampleID")
    metrics        <- c("Observed","Berger-Parker","PD","Shannon")
  } else {
    metrics <- c("Observed","Berger-Parker","Shannon")
  }

  meta_df <- as(sample_data(ps_rare), "data.frame")
  meta_df$SampleID <- sample_names(ps_rare)
  full_df <- merge(alpha_df, meta_df, by = "SampleID")

  save_csv(full_df, "7", paste0("AlphaDiversity_PerSample_", kingdom_name))

  subtitle_parts <- vapply(metrics, function(m) {
    res <- kruskal.test(as.formula(paste0("`", m, "` ~ Location")), data = full_df)
    fp  <- format.pval(res$p.value, digits = 3, eps = 0.001)
    cp  <- ifelse(grepl("<", fp), fp, paste0("= ", fp))
    paste(ifelse(m == "PD", "Faith's PD", m), cp)
  }, character(1))

  kw_pvals <- vapply(metrics, function(m) {
    kruskal.test(as.formula(paste0("`", m, "` ~ Location")), data = full_df)$p.value
  }, numeric(1))
  save_csv(data.frame(Metric = metrics, KW_p_value = kw_pvals),
           "7", paste0("AlphaDiversity_KWpvalues_", kingdom_name))

  subtitle_str <- paste("KW p-values |", paste(subtitle_parts, collapse = " | "))

  cols_pivot <- c("Observed","Berger-Parker","Shannon")
  if (has_tree) { colnames(full_df)[colnames(full_df) == "PD"] <- "Faith's PD"
  cols_pivot <- c("Observed","Berger-Parker","Faith's PD","Shannon") }

  plot_df <- full_df %>%
    select(SampleID, Location, all_of(cols_pivot)) %>%
    pivot_longer(cols = all_of(cols_pivot), names_to = "Metric", values_to = "Value") %>%
    mutate(Metric = factor(Metric, levels = cols_pivot,
                           labels = sub("^Observed$", "Observed richness", cols_pivot)))

  set.seed(123)
  ggplot(plot_df, aes(x = Location, y = Value, fill = Location)) +
    geom_boxplot(alpha = 0.7, color = "black", outlier.shape = NA) +
    geom_jitter(width = 0.2, alpha = 0.5) +
    facet_wrap(~ Metric, scales = "free_y", ncol = if(has_tree) 2L else 3L) +
    theme_pub() +
    theme(legend.position = "none",
          axis.text.x = element_text(angle = 45, hjust = 1),
          strip.text  = element_text(face = "bold", size = 11)) +
    labs(title = paste(kingdom_name, "Alpha Diversity"),
         subtitle = subtitle_str, y = "Index value", x = "Site")
}

