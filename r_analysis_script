run_ancom <- function(ps_obj, kingdom) {
  ps_fam <- tax_glom(ps_obj, taxrank = "Family", NArm = FALSE)
  set.seed(123)
  out <- ancombc2(data = ps_fam, assay_name = "counts", tax_level = "Family",
                  fix_formula = "SampleType", p_adj_method = "holm",
                  prv_cut = 0.10, lib_cut = 1000, group = "SampleType",
                  struc_zero = TRUE, neg_lb = TRUE, alpha = 0.05)
  res     <- out$res

  save_csv(res, "13", paste0("ANCOMBC_FullResults_", kingdom))

  lfc_col <- grep("^lfc_SampleType", colnames(res), value = TRUE)[1]
  q_col   <- grep("^q_SampleType",   colnames(res), value = TRUE)[1]

  if (!is.na(lfc_col)) {
    sig <- res %>% filter(!!sym(q_col) < 0.05) %>%
      arrange(dplyr::desc(abs(!!sym(lfc_col)))) %>% head(15)
    if (nrow(sig) > 0) {
      p <- ggplot(sig, aes(x = reorder(taxon, !!sym(lfc_col)),
                           y = !!sym(lfc_col), fill = !!sym(lfc_col) > 0)) +
        geom_col(color = "black") + coord_flip() +
        scale_fill_manual(values = c("TRUE"="#FF9F1C","FALSE"="#2EC4B6"),
                          labels = c("TRUE"="Processed Wood",
                                     "FALSE"="Natural Log")) +
        theme_pub() +
        labs(title = paste("ANCOM-BC:", kingdom),
             x = "Family", y = "Log-fold change", fill = "Higher in")
      return(list(plot = p, data = sig))
    }
    cat(paste("\nNote: No significant taxa for", kingdom, "\n"))
  }
  return(NULL)
}

