.contig_len <- function(ids){
  out <- setNames(rep(NA_integer_, length(ids)), ids)
  if(!file.exists(CONTIGS_FA)) stop("[mod6] ", CONTIGS_FA, " not found (contig lengths for Table S17)")
  h <- if(nzchar(Sys.which("grep"))) tryCatch(readLines(pipe(paste("grep '^>'", shQuote(CONTIGS_FA)))), error = function(e) NULL) else NULL
  if(is.null(h)){ h <- character(0); con <- file(CONTIGS_FA, "r"); on.exit(close(con))
    repeat { ln <- readLines(con, n = 200000L, warn = FALSE); if(!length(ln)) break; h <- c(h, ln[startsWith(ln, ">")]) } }
  nm <- sub("^>(\\S+).*$", "\\1", h); ln <- suppressWarnings(as.integer(sub("^.*\\blen=([0-9]+).*$", "\\1", h)))
  out[] <- ln[match(ids, nm)]; out }
.bakta_prod <- function(b){ f <- find1(file.path(BAKTA, b), paste0("^", b, "\\.tsv$")); if(is.na(f)) return(NULL)
  bk <- read.delim(f, header = FALSE, comment.char = "#", quote = "", stringsAsFactors = FALSE, fill = TRUE)
  tibble(contig = bk[[1]], start = as.numeric(bk[[3]]), stop = as.numeric(bk[[4]]), locus = bk[[6]], product = bk[[8]]) %>%
    filter(!is.na(start), nzchar(locus)) }
.genomad_genes <- function(b){ f <- find1(file.path(GENOMAD, b), paste0("^", b, "_genes\\.tsv$")); if(is.na(f)) return(NULL)
  g <- read.delim(f, stringsAsFactors = FALSE, quote = ""); tibble(gene_id = g$gene, gstart = as.numeric(g$start), gend = as.numeric(g$end)) }
.genomad_scores <- function(b){ f <- find1(file.path(GENOMAD, b), paste0("^", b, "_aggregated_classification\\.tsv$")); if(is.na(f)) return(NULL)
  read.delim(f, stringsAsFactors = FALSE) }
.virus_spans <- function(b){ f <- find1(file.path(GENOMAD, b), paste0("^", b, "_virus_summary\\.tsv$"))
  if(is.na(f)) return(NULL)
  v <- tryCatch(read.delim(f, stringsAsFactors = FALSE), error = function(e) NULL)
  if(is.null(v) || !nrow(v)) return(tibble(contig = character(), vs = numeric(), ve = numeric()))
  co <- strsplit(ifelse(is.na(v$coordinates), "", as.character(v$coordinates)), "-", fixed = TRUE)
  tibble(contig = sub("\\|.*$", "", v$seq_name),
         vs = vapply(co, function(x) if(length(x) == 2) as.numeric(x[1]) else -Inf, numeric(1)),
         ve = vapply(co, function(x) if(length(x) == 2) as.numeric(x[2]) else  Inf, numeric(1))) }
.integron_spans <- function(b){ f <- find1(file.path(INTEGRON, b), paste0("^", b, "\\.integrons$"))
  if(is.na(f)) return(NULL)
  x <- tryCatch(read.delim(f, comment.char = "#", stringsAsFactors = FALSE), error = function(e) NULL)
  if(is.null(x) || !nrow(x)) return(tibble(contig = character(), id = character(), type = character(), es = numeric(), ee = numeric()))
  x %>% filter(!is.na(pos_beg)) %>% group_by(contig = ID_replicon, id = ID_integron, type) %>%
    summarise(es = min(as.numeric(pos_beg)), ee = max(as.numeric(pos_end)), .groups = "drop") }
