generate_heatmap <- function(ps_rel, kingdom_name) {

  ps_fam   <- tax_glom(ps_rel, taxrank = "Family", NArm = FALSE)
  top30    <- names(sort(taxa_sums(ps_fam), decreasing = TRUE)[1:30])
  ps_top30 <- prune_taxa(top30, ps_fam)

  otu_h     <- as(otu_table(ps_top30), "matrix")[top30, , drop = FALSE]
  otu_h_log <- log10(otu_h * 10000 + 1)
  tax_h     <- as(tax_table(ps_top30), "matrix")[top30, , drop = FALSE]

  clean_names <- case_when(
    !is.na(tax_h[,"Family"]) & !tax_h[,"Family"] %in% c("","NA","Unknown") ~ tax_h[,"Family"],
    !is.na(tax_h[,"Order"])  & !tax_h[,"Order"]  %in% c("","NA","Unknown") ~ paste0("Unclass_", tax_h[,"Order"]),
    !is.na(tax_h[,"Phylum"]) & !tax_h[,"Phylum"] %in% c("","NA","Unknown") ~ paste0("Unclass_", tax_h[,"Phylum"]),
    TRUE ~ "Unclassified_Microbe"
  )
  rownames(otu_h_log) <- make.unique(as.character(clean_names))

  meta_h <- data.frame(sample_data(ps_top30)) %>%
    select(SampleType, Location) %>%
    arrange(SampleType, Location)

  otu_h_log   <- otu_h_log[, rownames(meta_h)]
  ann_colors  <- list(SampleType = c("Processed Wood" = "#FF9F1C", "Natural Log" = "#2EC4B6"))
  split_index <- sum(meta_h$SampleType == "Natural Log")

  hm_obj <- pheatmap(otu_h_log, scale = "row", annotation_col = meta_h,
                     annotation_colors = ann_colors,
                     color = colorRampPalette(c("navy","white","firebrick3"))(50),
                     show_colnames = FALSE, cluster_rows = TRUE, cluster_cols = FALSE,
                     gaps_col = split_index,
                     main = paste(kingdom_name, "- Top 30 Families (Log10 Z-Score)"),
                     silent = TRUE)

  grid::grid.newpage(); grid::grid.draw(hm_obj$gtable)
  return(hm_obj)
}

