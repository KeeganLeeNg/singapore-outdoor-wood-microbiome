  rd_bm <- function(b){
    f <- file.path(SHOT, "12_xenobiotic", paste0(b, "_bacmet.tsv"))
    if(!file.exists(f) || file.size(f) == 0) return(NULL)
    bm <- read.delim(f, header = FALSE, stringsAsFactors = FALSE, quote = "")
    sp <- strsplit(bm[[2]], "\\|")
    data.frame(bin = b, ref = vapply(sp, function(x) x[1], ""),
               gene = vapply(sp, function(x) if(length(x) >= 2) x[2] else NA_character_, ""),
               pid = suppressWarnings(as.numeric(bm[[3]])), stringsAsFactors = FALSE) }
  bmr <- tryCatch({ d <- do.call(rbind, lapply(ret$bin, rd_bm)); d[!is.na(d$gene) & !is.na(d$pid), ] }, error = function(e) NULL)
  put("BACMET_HITS",     big(nrow(bmr)))
  put("BACMET_BAND",     big(sum(bmr$pid >= 40 & bmr$pid < 50)))
  put("BACMET_BAND_PCT", sprintf("%.0f", 100 * mean(bmr$pid >= 40 & bmr$pid < 50)))
  bac <- sort(unique(bmr$ref[grepl("^BAC[0-9]+$", bmr$ref)]))
  put("BACMET_NBAC",      length(bac))
  put("BACMET_BAC_RANGE", if(length(bac)) paste(bac[1], bac[length(bac)], sep = "-") else NA)
  put("BACMET_NONBAC",    length(unique(bmr$ref)) - length(bac))
  cm <- tryCatch({ d <- do.call(rbind, lapply(con$bin, rd_bm)); d[!is.na(d$gene) & !is.na(d$pid) & d$pid >= BACMET_PID, ] }, error = function(e) NULL)
  if(!is.null(cm) && nrow(cm)){
    cc <- table(factor(classify_tol(cm$gene), levels = c("copper", "efflux")))
    put("CONTAM_EFFLUX_N",     cc[["efflux"]])
    put("CONTAM_EFFLUX_SHARE", sprintf("%.0f", 100 * cc[["efflux"]] / (sum(ct$efflux_baseline) + cc[["efflux"]])))
    put("CONTAM_COPPER_SHARE", sprintf("%.0f", 100 * cc[["copper"]] / (sum(ct$copper) + cc[["copper"]]))) }
  put("PRES_CATALOGUE", sum(rd("M6_preservative_reconciliation.csv")$catalogue_copies_eggNOG))

  ko <- tryCatch(rd("M8_shotgun_only_KO_scope.csv"), error = function(e) NULL)
  put("KO_SHOTGUN_ONLY",     big(ko$shotgun_only_total))
  put("KO_PROK",             big(ko$prokaryote_annotated))
  put("KO_EUK",              big(ko$eukaryote_or_viral))
  put("KO_PCT_PROK_OF_ONLY", sprintf("%.0f", 100 * ko$prokaryote_annotated / ko$shotgun_only_total))
