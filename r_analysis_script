  rd  <- function(f) read.csv(file.path(TAB, f), check.names = FALSE, stringsAsFactors = FALSE)
  f1  <- function(x) sprintf("%.1f", x); f2 <- function(x) sprintf("%.2f", x); f3 <- function(x) sprintf("%.3f", x)
  big <- function(x) format(x, big.mark = ",", scientific = FALSE, trim = TRUE)

  q   <- tryCatch(rd("M4_mag_quality_taxonomy.csv"), error = function(e) NULL)
