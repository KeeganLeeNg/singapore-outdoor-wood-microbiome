cat("\n--- 8. Beta-Diversity ---\n")

plot_beta_diversity <- function(ps_rare, kingdom_name, has_tree = FALSE) {

  meta_df <- as(sample_data(ps_rare), "data.frame")

  dist_metrics <- list(
    "BrayCurtis" = phyloseq::distance(ps_rare, method = "bray"),
    "Jaccard"    = phyloseq::distance(ps_rare, method = "jaccard", binary = TRUE)
  )
  if (has_tree) {
    dist_metrics[["Weighted_UniFrac"]]   <- phyloseq::distance(ps_rare, method = "wunifrac")
    dist_metrics[["Unweighted_UniFrac"]] <- phyloseq::distance(ps_rare, method = "unifrac")
  }

  plot_list  <- list()
  stats_rows <- list()

  for (m_name in names(dist_metrics)) {
    dist_obj <- dist_metrics[[m_name]]

    cat(paste("\n---", kingdom_name, "|", m_name, "| Dispersion (SampleType) ---\n"))
    set.seed(123); bd_st <- permutest(betadisper(dist_obj, meta_df$SampleType), permutations = 999); print(bd_st)
    cat(paste("\n---", kingdom_name, "|", m_name, "| Dispersion (Location) ---\n"))
    set.seed(123); bd_lo <- permutest(betadisper(dist_obj, meta_df$Location),  permutations = 999); print(bd_lo)

    cat(paste("\n---", kingdom_name, "|", m_name, "| Marginal PERMANOVA ---\n"))
    set.seed(123)
    perm <- adonis2(dist_obj ~ Location + SampleType, data = meta_df,
                    by = "margin", permutations = 999)
    print(perm)

    r2_t <- perm["SampleType","R2"]; p_t <- perm["SampleType","Pr(>F)"]
    r2_l <- perm["Location",  "R2"]; p_l <- perm["Location",  "Pr(>F)"]

    if (m_name == "BrayCurtis") {
      nn <- nsamples(ps_rare)
      fig_sheet <- "Figure 2"
      fig_stat(fig_sheet, kingdom_name, "PERMANOVA substrate R2", round(r2_t, 4), p_t, nn,
               "adonis2 marginal, Bray-Curtis, 999 perm", "block 8")
      fig_stat(fig_sheet, kingdom_name, "PERMANOVA location R2",  round(r2_l, 4), p_l, nn,
               "adonis2 marginal, Bray-Curtis, 999 perm", "block 8")
      fig_stat(fig_sheet, kingdom_name, "betadisper substrate p", round(bd_st$tab[1, "Pr(>F)"], 4), NA, nn,
               "PERMDISP, 999 perm", "block 8")
      fig_stat(fig_sheet, kingdom_name, "betadisper location p",  round(bd_lo$tab[1, "Pr(>F)"], 4), NA, nn,
               "PERMDISP, 999 perm", "block 8")
    }
    if (m_name == "Weighted_UniFrac") {
      nn <- nsamples(ps_rare)
      fig_sheet <- "Figure 2"
      fig_stat(fig_sheet, kingdom_name, "PERMANOVA substrate R2 (weighted UniFrac)", round(r2_t, 4), p_t, nn,
               "adonis2 marginal, weighted UniFrac, 999 perm", "block 8")
      fig_stat(fig_sheet, kingdom_name, "PERMANOVA location R2 (weighted UniFrac)",  round(r2_l, 4), p_l, nn,
               "adonis2 marginal, weighted UniFrac, 999 perm", "block 8")
