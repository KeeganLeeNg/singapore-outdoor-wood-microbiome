clean_xlsx_package <- function(f) {
  td <- tempfile("xlsx_"); dir.create(td); on.exit(unlink(td, recursive = TRUE), add = TRUE)
  utils::unzip(f, exdir = td)
  rd_txt <- function(p) paste(readLines(p, warn = FALSE, encoding = "UTF-8"), collapse = "\n")
  wr_txt <- function(x, p) { con <- file(p, open = "wb"); writeBin(charToRaw(enc2utf8(x)), con); close(con) }
  n_removed <- 0L
  for (r in list.files(td, pattern = "\\.rels$", recursive = TRUE, full.names = TRUE, all.files = TRUE)) {
    x <- rd_txt(r); base <- dirname(dirname(r))
    rel <- regmatches(x, gregexpr("<Relationship [^>]*/>", x))[[1]]
    for (el in rel) {
      tgt <- sub('^.*Target="([^"]+)".*$', "\\1", el)
      if (grepl('TargetMode="External"', el, fixed = TRUE) || grepl("^/", tgt)) next
      if (!file.exists(file.path(base, tgt))) { x <- sub(el, "", x, fixed = TRUE); n_removed <- n_removed + 1L }
    }
    wr_txt(x, r)
  }
  ct <- file.path(td, "[Content_Types].xml"); x <- rd_txt(ct)
  for (el in regmatches(x, gregexpr("<Override [^>]*/>", x))[[1]]) {
    part <- sub('^.*PartName="/([^"]+)".*$', "\\1", el)
    if (!file.exists(file.path(td, part))) { x <- sub(el, "", x, fixed = TRUE); n_removed <- n_removed + 1L }
  }
  wr_txt(x, ct)
  parts <- list.files(td, recursive = TRUE, all.files = TRUE)
  parts <- c("[Content_Types].xml", setdiff(parts, "[Content_Types].xml"))
  tmp <- tempfile(fileext = ".xlsx")
  zip::zip(tmp, files = parts, root = td, mode = "mirror")
  if (!file.copy(tmp, f, overwrite = TRUE)) stop("could not write the cleaned workbook: ", f)
  n_removed
}
